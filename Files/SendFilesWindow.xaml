<ui:ChromeWindow x:Class="MeshControl.Files.SendFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Envoyer des fichiers — Mesh Control" Height="720" Width="1000"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <ui:ChromeWindow.Resources>
        <!-- Pastille numérotée des trois étapes : fichiers, appareils, destination -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Ligne simple : survol seulement, pas de sélection -->
        <Style x:Key="PlainItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="10,6" Margin="6,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ligne d'appareil cochable : toute la ligne bascule la case, et une
             machine retenue se teinte de bleu pour se repérer dans une longue liste. -->
        <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="10,7" Margin="6,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:ChromeWindow.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True"
          DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <DockPanel Margin="20,16,20,18">

            <!-- En-tête -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Envoyer des fichiers" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource CaptionText}"
                               FontSize="12" Margin="0,2,0,0"
                               Text="Vers une ou plusieurs machines : les envois partent en parallèle."/>
                </StackPanel>
            </Grid>

            <!-- Pied, composition : la destination et le bouton d'envoi -->
            <Border x:Name="ComposeFooter" DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                    Padding="16,14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource StepBadge}" VerticalAlignment="Top" Margin="0,1,10,0">
                        <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="Destination" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,10"/>

                        <Grid x:Name="WindowsDestinationRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▤" Foreground="#0A84FF" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Windows" Style="{StaticResource FieldLabel}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="WindowsPathBox" Grid.Column="1" FontFamily="Consolas"
                                     FontSize="12.5" TextChanged="Destination_TextChanged"/>
                        </Grid>

                        <Grid x:Name="UnixDestinationRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="◈" Foreground="#F0883E" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Linux / macOS" Style="{StaticResource FieldLabel}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="UnixPathBox" Grid.Column="1" FontFamily="Consolas"
                                     FontSize="12.5" TextChanged="Destination_TextChanged"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="120,2,0,0">
                            <CheckBox x:Name="CreateFolderCheck" IsChecked="True"
                                      Content="Créer le dossier s'il n'existe pas"/>
                            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Text="Un fichier du même nom déjà présent est remplacé."/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            Padding="22,12" VerticalAlignment="Bottom" Click="Send_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="SendButtonText" Text="Envoyer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Pied, suivi : relancer, annuler, fermer -->
            <Grid x:Name="ProgressFooter" DockPanel.Dock="Bottom" Margin="0,14,0,0"
                  Visibility="Collapsed">
                <Button x:Name="NewBatchButton" Style="{StaticResource ToolButton}"
                        HorizontalAlignment="Left" Padding="12,8" Click="NewBatch_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Modifier et renvoyer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryAllButton" Style="{StaticResource ToolButton}"
                            Padding="12,8" Margin="0,0,8,0" Click="RetryAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Réessayer les échecs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelAllButton" Style="{StaticResource ToolButton}"
                            Padding="12,8" Margin="0,0,8,0" Content="Tout annuler"
                            Foreground="{StaticResource DangerBrush}" Click="CancelAll_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}"
                            Padding="22,8" Content="Fermer" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid>
                <!-- Vue 1 : composition de l'envoi -->
                <Grid x:Name="ComposePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Étape 1 : les fichiers -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,14,14,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                                    </Border>
                                    <TextBlock Text="Fichiers" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="FilesSummary" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SeparatorBrush}"
                                    BorderThickness="0,1,0,0" Padding="8,7">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SubtleButton}" Padding="8,4"
                                                Click="AddFiles_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="Ajouter des fichiers…"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SubtleButton}" Padding="8,4"
                                                Click="AddFolder_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="Ajouter un dossier…"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button x:Name="ClearFilesButton" Style="{StaticResource SubtleButton}"
                                            Padding="8,4" HorizontalAlignment="Right"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Content="Tout retirer" Click="ClearFiles_Click"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <!-- Zone de dépôt, tant que rien n'est choisi -->
                                <Grid x:Name="FilesDropZone" Margin="14,0,14,14">
                                    <Rectangle RadiusX="12" RadiusY="12" Fill="#F7F9FC"
                                               Stroke="#C7D7EE" StrokeThickness="1.5"
                                               StrokeDashArray="5 3"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Margin="20">
                                        <Border Width="54" Height="54" CornerRadius="16"
                                                Background="{StaticResource AccentSoftBrush}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Glissez vos fichiers ou dossiers ici"
                                                   FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="12"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="280"
                                                   Text="Les dossiers sont envoyés avec toute leur arborescence."/>
                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="FileListBox" Style="{StaticResource DeviceListBoxStyle}"
                                         ItemContainerStyle="{StaticResource PlainItemStyle}"
                                         Margin="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding Path}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Background="{Binding GlyphBackground}">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Foreground="{Binding GlyphColor}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,8,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="&#xE711;" ToolTip="Retirer"
                                                        Tag="{Binding}" Click="RemoveEntry_Click"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Étape 2 : les appareils -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,14,14,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StepBadge}">
                                        <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                                    </Border>
                                    <TextBlock Text="Appareils" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="DevicesSummary" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Recherche -->
                            <Border DockPanel.Dock="Top" Height="34" CornerRadius="8" Background="White"
                                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                    Margin="14,0,14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="#AEAEB2" Margin="12,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Grid Grid.Column="1" Margin="8,0,8,0">
                                        <TextBox x:Name="DeviceSearchBox" BorderThickness="0"
                                                 Background="Transparent" Padding="0" FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="DeviceSearch_TextChanged"/>
                                        <TextBlock x:Name="DeviceSearchPlaceholder"
                                                   Text="Rechercher un appareil ou un dossier…"
                                                   FontSize="13" Foreground="#AEAEB2"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid DockPanel.Dock="Top" Margin="14,0,14,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SubtleButton}" Padding="2,3"
                                            Content="Tout sélectionner" Click="SelectAll_Click"/>
                                    <TextBlock Text="·" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0"/>
                                    <Button Style="{StaticResource SubtleButton}" Padding="2,3"
                                            Content="Aucun" Click="SelectNone_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="OfflineHint" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <ListBox x:Name="DeviceListBox" Style="{StaticResource DeviceListBoxStyle}"
                                         ItemContainerStyle="{StaticResource PickerItemStyle}"
                                         Margin="0,0,0,6"
                                         PreviewMouseLeftButtonUp="DeviceList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          IsHitTestVisible="False" Focusable="False"
                                                          VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8"
                                                        Margin="8,0,11,0"
                                                        Background="{Binding Row.OsGlyphBackground}">
                                                    <TextBlock Text="{Binding Row.OsGlyph}" FontSize="15"
                                                               Foreground="{Binding Row.OsGlyphColor}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="NoDeviceText" Style="{StaticResource CaptionText}"
                                           FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="24" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Vue 2 : suivi de l'envoi, machine par machine -->
                <DockPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OverallBadge" Width="40" Height="40" CornerRadius="11"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock x:Name="OverallGlyph" Text="&#xE898;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="OverallTitle" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="OverallSubtitle" Style="{StaticResource CaptionText}"
                                               FontSize="12" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="OverallPercent" Grid.Column="2" FontSize="24"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="OverallBar" Style="{StaticResource SlimProgressBar}"
                                         Height="6" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                            Padding="14,12" Margin="0,0,0,8"
                                            ToolTip="{Binding Destination}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="36" Height="36" CornerRadius="9"
                                                    Background="{Binding Row.OsGlyphBackground}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Row.OsGlyph}" FontSize="16"
                                                           Foreground="{Binding Row.OsGlyphColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="13,0,14,0"
                                                        VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,120,0"/>
                                                    <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource SlimProgressBar}"
                                                             Value="{Binding Fraction, Mode=OneWay}"
                                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Foreground="{Binding BarColor}"
                                                             Margin="0,7,0,6"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                           Foreground="{Binding StatusColor}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding StateGlyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{Binding StatusColor}"
                                                       Visibility="{Binding StateGlyphVisibility}"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource ToolButton}"
                                                    Background="#F2F2F7" Padding="10,6"
                                                    Visibility="{Binding RetryVisibility}"
                                                    Tag="{Binding}" Click="RetryDevice_Click"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock Text="Réessayer" FontSize="11.5"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Voile de dépôt -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="10">
            <Rectangle RadiusX="14" RadiusY="14" Fill="#EBF4FF"
                       Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                       StrokeDashArray="5 3"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="60" Height="60" CornerRadius="30"
                        Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Déposer pour ajouter à l'envoi" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:ChromeWindow>
