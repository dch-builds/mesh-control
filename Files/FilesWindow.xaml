<ui:ChromeWindow x:Class="MeshControl.Files.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Fichiers — Mesh Control" Height="680" Width="960"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <ui:ChromeWindow.Resources>
        <!-- Bouton de l'en-tête : posé sur fond blanc, il lui faut un fond
             propre pour se lire comme un bouton avant même d'être survolé. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton rond entre les deux volets : fait passer la sélection d'un
             côté à l'autre. -->
        <Style x:Key="PaneTransferButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20"
                                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment du fil d'Ariane -->
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- En-têtes de colonnes plats, à la place du dégradé Windows -->
        <Style x:Key="FileHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid Background="Transparent">
                            <Border BorderBrush="{StaticResource SeparatorBrush}"
                                    BorderThickness="0,0,0,1" Padding="16,10,8,8">
                                <ContentPresenter TextElement.FontSize="11"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                                   Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ligne de fichier : arrondie, survol et sélection dans la palette de
             la liste d'appareils. -->
        <Style x:Key="FileItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Margin="6,1" Padding="0,4">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cellules, partagées par la liste distante et la liste locale -->
        <DataTemplate x:Key="NameCell">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7"
                        Background="{Binding GlyphBackground}" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{Binding GlyphColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="11,0,0,0" FontSize="12.5"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding SizeText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="ModifiedCell">
            <TextBlock Text="{Binding ModifiedText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="KindCell">
            <TextBlock Text="{Binding KindText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </ui:ChromeWindow.Resources>

    <!-- AllowDrop sur le panneau entier : on peut lâcher les fichiers n'importe
         où dans la fenêtre. Background explicite, sinon les zones sans dessin ne
         reçoivent aucun événement de survol. Le volet local traite lui-même les
         dépôts qui le visent. -->
    <DockPanel x:Name="RootPanel" Background="Transparent" AllowDrop="True"
               DragOver="RootPanel_DragOver" DragLeave="RootPanel_DragLeave"
               Drop="RootPanel_Drop">

        <!-- En-tête : la machine, son état, les actions -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="16,12,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="#FEF3DC" VerticalAlignment="Center">
                        <TextBlock Text="&#xF12B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#E89B0C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="StatusBadge" CornerRadius="8" Padding="7,1"
                                Margin="0,3,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="StatusLabel" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Bascule simple / double volet -->
                    <Button x:Name="DualPaneButton" Style="{StaticResource HeaderButton}"
                            Click="DualPane_Click" Margin="0,0,14,0"
                            ToolTip="Afficher les dossiers de ce poste à gauche, ceux de la machine à droite">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Double volet" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UploadButton" Style="{StaticResource AccentToolButton}"
                            Padding="12,7" Click="Upload_Click" Margin="0,0,6,0"
                            ToolTip="Envoyer des fichiers dans ce dossier — ou les glisser depuis l'Explorateur">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Envoyer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadButton" Style="{StaticResource HeaderButton}"
                            Click="Download_Click" Margin="0,0,6,0"
                            ToolTip="Télécharger les fichiers et dossiers sélectionnés">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Télécharger" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewFolderButton" Style="{StaticResource HeaderButton}"
                            Click="NewFolder_Click" Margin="0,0,6,0"
                            ToolTip="Créer un dossier sur la machine distante">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Nouveau dossier" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MultiDeviceButton" Style="{StaticResource HeaderButton}"
                            Click="SendToDevices_Click"
                            ToolTip="Envoyer des fichiers vers cette machine et d'autres, en parallèle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Plusieurs appareils…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panneau des transferts : un résumé, et le détail fichier par fichier -->
        <Border x:Name="TransferPanel" DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                Margin="12,0,12,12" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="14,11,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TransferHeaderBadge" Width="32" Height="32" CornerRadius="9"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock x:Name="TransferHeaderGlyph" Text="&#xE898;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TransferTitle" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TransferSubtitle" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ClearFinishedButton" Content="Effacer la liste"
                                Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                                Click="ClearFinished_Click"/>
                        <Button x:Name="CancelTransferButton" Content="Tout annuler"
                                Style="{StaticResource HeaderButton}" Padding="10,5"
                                Foreground="{StaticResource DangerBrush}" Margin="0,0,6,0"
                                Click="CancelTransfer_Click"/>
                        <Button x:Name="ToggleTransfersButton" Style="{StaticResource IconButton}"
                                Content="&#xE70D;" Click="ToggleTransfers_Click"
                                ToolTip="Masquer le détail"/>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="TransferBar" Style="{StaticResource SlimProgressBar}"
                             Margin="14,0,14,11"/>

                <Border x:Name="TransferListHost" BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,1,0,0">
                    <ScrollViewer MaxHeight="216" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TransferList" Margin="6,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5" ToolTip="{Binding Tooltip}" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Pastille du type de fichier, et sens du transfert en médaillon -->
                                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Background="{Binding GlyphBackground}">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13" Foreground="{Binding GlyphColor}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="15" Height="15" CornerRadius="7.5" Background="White"
                                                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,-4,-4">
                                                <TextBlock Text="{Binding DirectionGlyph}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="7"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Style="{StaticResource SlimProgressBar}" Height="3"
                                                         Value="{Binding Fraction, Mode=OneWay}"
                                                         Visibility="{Binding ProgressVisibility}"
                                                         Margin="0,4,0,3"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{Binding DetailColor}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding StateGlyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{Binding StateColor}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                                        <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                Content="{Binding ActionGlyph}"
                                                ToolTip="{Binding ActionTooltip}"
                                                Visibility="{Binding ActionVisibility}"
                                                Tag="{Binding}" Click="TransferAction_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- Les volets : ce poste (double volet seulement), passerelle, machine distante.
             Les colonnes du volet local sont réglées par code : à zéro en vue simple. -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LocalColumn" Width="0"/>
                <ColumnDefinition x:Name="BridgeColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Volet local -->
            <Border x:Name="LocalPane" Style="{StaticResource Card}" Visibility="Collapsed"
                    AllowDrop="True" DragOver="LocalPane_DragOver" DragLeave="LocalPane_DragLeave"
                    Drop="LocalPane_Drop">
                <Grid>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,4">
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Ce poste" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LocalUpButton" Style="{StaticResource HeaderButton}"
                                        Click="LocalUp_Click" Padding="9,8" Margin="0,0,6,0"
                                        ToolTip="Dossier parent">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource HeaderButton}"
                                        Click="LocalRefresh_Click" Padding="9,8" Margin="0,0,8,0"
                                        ToolTip="Actualiser">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Border Grid.Column="2" Background="#F2F2F7" CornerRadius="8"
                                        Padding="4,0" Height="32">
                                    <ScrollViewer x:Name="LocalBreadcrumbScroller"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="LocalBreadcrumbPanel" Orientation="Horizontal"
                                                    VerticalAlignment="Center"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Grid>
                            <ListView x:Name="LocalList" BorderThickness="0" Background="Transparent"
                                      ItemContainerStyle="{StaticResource FileItemStyle}"
                                      SelectionMode="Extended" Margin="0,0,0,6"
                                      MouseDoubleClick="LocalList_MouseDoubleClick"
                                      PreviewKeyDown="LocalList_PreviewKeyDown"
                                      SelectionChanged="PaneSelection_Changed">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource FileHeaderStyle}">
                                        <GridViewColumn Header="Nom" Width="250"
                                                        CellTemplate="{StaticResource NameCell}"/>
                                        <GridViewColumn Header="Taille" Width="80"
                                                        CellTemplate="{StaticResource SizeCell}"/>
                                        <GridViewColumn Header="Modifié le" Width="125"
                                                        CellTemplate="{StaticResource ModifiedCell}"/>
                                        <GridViewColumn Header="Type" Width="110"
                                                        CellTemplate="{StaticResource KindCell}"/>
                                    </GridView>
                                </ListView.View>

                                <ListView.ContextMenu>
                                    <ContextMenu Opened="LocalMenu_Opened">
                                        <MenuItem x:Name="LocalMenuSend" Header="Envoyer vers la machine"
                                                  FontWeight="SemiBold" Click="SendLocal_Click"/>
                                        <MenuItem x:Name="LocalMenuOpen" Header="Ouvrir"
                                                  Click="LocalMenuOpen_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="LocalMenuReveal" Header="Afficher dans l'Explorateur"
                                                  Click="LocalMenuReveal_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>

                            <StackPanel x:Name="LocalEmptyState" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" IsHitTestVisible="False"
                                        Margin="0,30,0,0" Visibility="Collapsed">
                                <Border Width="52" Height="52" CornerRadius="15" Background="#F2F2F7"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xF12B;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="LocalEmptyText" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="260" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <!-- Voile : fichiers distants glissés vers ce poste -->
                    <Grid x:Name="LocalDropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle RadiusX="12" RadiusY="12" Fill="#EBF4FF"
                                   Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                   StrokeDashArray="5 3"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Déposer pour télécharger" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock x:Name="LocalDropOverlayText" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,5,0,0" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Passerelle entre les volets -->
            <StackPanel x:Name="BridgePanel" Grid.Column="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="SendLocalButton" Style="{StaticResource PaneTransferButton}"
                        Content="&#xE72A;" Click="SendLocal_Click" Margin="0,0,0,10"
                        ToolTip="Envoyer la sélection de ce poste vers la machine"/>
                <Button x:Name="DownloadHereButton" Style="{StaticResource PaneTransferButton}"
                        Content="&#xE72B;" Click="DownloadHere_Click"
                        ToolTip="Télécharger la sélection de la machine dans ce dossier"/>
            </StackPanel>

            <!-- Volet distant -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="0,0,0,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,4">
                            <StackPanel x:Name="RemotePaneTitle" Orientation="Horizontal"
                                        Margin="4,0,0,8" Visibility="Collapsed">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="RemotePaneTitleText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Navigation : parent, actualiser, fil d'Ariane cliquable -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="UpButton" Style="{StaticResource HeaderButton}"
                                        Click="Up_Click" Padding="9,8" Margin="0,0,6,0"
                                        ToolTip="Dossier parent (Retour arrière)">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource HeaderButton}"
                                        Click="Refresh_Click" Padding="9,8" Margin="0,0,8,0"
                                        ToolTip="Actualiser (F5)">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>

                                <Border Grid.Column="2" Background="#F2F2F7" CornerRadius="8"
                                        Padding="4,0" Height="32">
                                    <!-- Défilement horizontal sans barre : un chemin trop long
                                         reste ancré sur son dernier dossier, le plus utile. -->
                                    <ScrollViewer x:Name="BreadcrumbScroller"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"
                                                    VerticalAlignment="Center"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Grid>
                            <ListView x:Name="FileList" BorderThickness="0" Background="Transparent"
                                      ItemContainerStyle="{StaticResource FileItemStyle}"
                                      MouseDoubleClick="FileList_MouseDoubleClick"
                                      SelectionMode="Extended"
                                      PreviewKeyDown="FileList_PreviewKeyDown"
                                      SelectionChanged="PaneSelection_Changed">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource FileHeaderStyle}">
                                        <GridViewColumn Header="Nom" Width="430"
                                                        CellTemplate="{StaticResource NameCell}"/>
                                        <GridViewColumn Header="Taille" Width="110"
                                                        CellTemplate="{StaticResource SizeCell}"/>
                                        <GridViewColumn Header="Modifié le" Width="150"
                                                        CellTemplate="{StaticResource ModifiedCell}"/>
                                        <GridViewColumn Header="Type" Width="150"
                                                        CellTemplate="{StaticResource KindCell}"/>
                                    </GridView>
                                </ListView.View>

                                <ListView.ContextMenu>
                                    <ContextMenu Opened="FileMenu_Opened">
                                        <MenuItem x:Name="MenuOpen" Header="Ouvrir" FontWeight="SemiBold"
                                                  Click="MenuOpen_Click"/>
                                        <MenuItem x:Name="MenuDownload" Header="Télécharger…"
                                                  Click="Download_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuRename" Header="Renommer…"
                                                  Click="MenuRename_Click"/>
                                        <MenuItem x:Name="MenuDelete" Header="Supprimer…"
                                                  Click="MenuDelete_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuCopyPath" Header="Copier le chemin"
                                                  Click="MenuCopyPath_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>

                            <!-- État vide : dossier vide, illisible, ou connexion en cours.
                                 Sans lui, une liste blanche ne dit pas si elle est vide
                                 ou simplement pas encore arrivée. -->
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" IsHitTestVisible="False"
                                        Margin="0,30,0,0" Visibility="Collapsed">
                                <Border Width="58" Height="58" CornerRadius="16" Background="#F2F2F7"
                                        HorizontalAlignment="Center">
                                    <TextBlock x:Name="EmptyGlyph" Text="&#xF12B;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="EmptyTitle" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock x:Name="EmptyHint" Style="{StaticResource CaptionText}"
                                           FontSize="12" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                                           Margin="0,5,0,0"/>
                                <ProgressBar x:Name="EmptyProgress" Style="{StaticResource SlimProgressBar}"
                                             Width="140" Margin="0,14,0,0" IsIndeterminate="True"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Repère visuel du dépôt : sans lui, rien ne dirait que la fenêtre
                     accepte les fichiers glissés depuis l'Explorateur. -->
                <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle RadiusX="12" RadiusY="12" Fill="#EBF4FF"
                               Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                               StrokeDashArray="5 3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="30"
                                Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Déposer pour envoyer" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="DropOverlayText" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,5,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</ui:ChromeWindow>
