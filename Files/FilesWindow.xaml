<Window x:Class="MeshControl.Files.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fichiers — Mesh Control" Height="640" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel x:Name="RootPanel">
        <!-- Barre d'outils -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border x:Name="StatusBadge" CornerRadius="8" Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLabel" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UploadButton" Content="Envoyer…"
                            Style="{StaticResource ToolButton}" Click="Upload_Click"
                            Margin="0,0,6,0" ToolTip="Envoyer un fichier dans ce dossier"/>
                    <Button x:Name="DownloadButton" Content="Télécharger"
                            Style="{StaticResource ToolButton}" Click="Download_Click"
                            Margin="0,0,6,0" ToolTip="Télécharger le fichier sélectionné"/>
                    <Button x:Name="NewFolderButton" Content="Nouveau dossier"
                            Style="{StaticResource ToolButton}" Click="NewFolder_Click"
                            Margin="0,0,6,0"/>
                    <Button x:Name="RefreshButton" Content="Actualiser"
                            Style="{StaticResource ToolButton}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chemin courant -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UpButton" Content="↑" Style="{StaticResource ToolButton}"
                        Click="Up_Click" Padding="9,3" Margin="0,0,10,0"
                        ToolTip="Dossier parent"/>
                <TextBlock x:Name="PathText" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Barre de progression du transfert -->
        <Border x:Name="TransferPanel" DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="TransferLabel" Style="{StaticResource CaptionText}"
                               Margin="0,0,0,4"/>
                    <ProgressBar x:Name="TransferBar" Height="4" Minimum="0" Maximum="1"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#EFEFF4" BorderThickness="0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Annuler" Style="{StaticResource ToolButton}"
                        Click="CancelTransfer_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Liste des fichiers -->
        <Border Padding="12">
            <Border Style="{StaticResource Card}" Padding="0">
                <ListView x:Name="FileList" BorderThickness="0" Background="Transparent"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          SelectionMode="Extended"
                          PreviewKeyDown="FileList_PreviewKeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nom" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontSize="14"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Taille" Width="110"
                                            DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="Modifié le" Width="160"
                                            DisplayMemberBinding="{Binding ModifiedText}"/>
                            <GridViewColumn Header="Type" Width="120"
                                            DisplayMemberBinding="{Binding KindText}"/>
                        </GridView>
                    </ListView.View>

                    <ListView.ContextMenu>
                        <ContextMenu Opened="FileMenu_Opened">
                            <MenuItem x:Name="MenuOpen" Header="Ouvrir" FontWeight="SemiBold"
                                      Click="MenuOpen_Click"/>
                            <MenuItem x:Name="MenuDownload" Header="Télécharger…"
                                      Click="Download_Click"/>
                            <Separator/>
                            <MenuItem x:Name="MenuRename" Header="Renommer…"
                                      Click="MenuRename_Click"/>
                            <MenuItem x:Name="MenuDelete" Header="Supprimer…"
                                      Click="MenuDelete_Click"/>
                            <Separator/>
                            <MenuItem x:Name="MenuCopyPath" Header="Copier le chemin"
                                      Click="MenuCopyPath_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Border>
        </Border>
    </DockPanel>
</Window>
