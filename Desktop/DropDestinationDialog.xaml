<ui:ChromeWindow x:Class="MeshControl.Desktop.DropDestinationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Envoyer vers la machine"
        Width="520" Height="560" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <ui:ChromeWindow.Resources>
        <!-- Raccourci cliquable : un clic remplit le chemin, un double-clic envoie. -->
        <Style x:Key="ShortcutItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="10,6" Margin="6,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une ligne d'emplacement ou de dossier : pastille, nom, chemin. -->
        <DataTemplate x:Key="ShortcutTemplate">
            <Grid ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8"
                        Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Les dossiers parcourus n'ont pas de détail : pas de ligne vide. -->
                <DataTrigger Binding="{Binding Detail}" Value="">
                    <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:ChromeWindow.Resources>

    <DockPanel Margin="20,16,20,18">
        <!-- En-tête -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Où envoyer ces fichiers ?" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionText}" FontSize="12"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Pied : chemin choisi et boutons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Dossier de destination" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="PathBox" FontSize="13" TextChanged="PathBox_TextChanged"/>
            <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="Collapsed"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Le dossier est créé s'il n'existe pas. Un fichier du même nom est remplacé."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Annuler" Style="{StaticResource ToolButton}" IsCancel="True"
                        Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/>
                <Button x:Name="SendButton" Content="Envoyer"
                        Style="{StaticResource PrimaryButton}"
                        Click="Send_Click" Padding="18,8" IsDefault="True"/>
            </StackPanel>
        </StackPanel>

        <!-- Emplacements courants de la machine, ou navigation libre -->
        <ui:CardBorder Style="{StaticResource Card}">
            <DockPanel>
                <!-- En-tête des emplacements -->
                <Grid x:Name="ShortcutsHeader" DockPanel.Dock="Top" Margin="16,10,10,6">
                    <TextBlock Text="Emplacements" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="LoadingText" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="Recherche des dossiers de la machine…"/>
                        <Button Content="Parcourir…" Style="{StaticResource ToolButton}"
                                Click="Browse_Click" Padding="10,4"
                                ToolTip="Choisir un dossier en naviguant sur la machine"/>
                    </StackPanel>
                </Grid>

                <!-- En-tête de la navigation : retour, parent, chemin affiché -->
                <Grid x:Name="BrowseHeader" DockPanel.Dock="Top" Margin="10,8,14,6"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;"
                            FontSize="11" Click="BackToShortcuts_Click"
                            ToolTip="Revenir aux emplacements"/>
                    <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource IconButton}"
                            Content="&#xE74A;" FontSize="11" Margin="2,0,0,0"
                            Click="Up_Click" ToolTip="Dossier parent"/>
                    <TextBlock x:Name="BrowsePathText" Grid.Column="2" FontSize="12.5"
                               FontWeight="SemiBold" Margin="8,0,8,0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="BrowseStatus" Grid.Column="3"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <ListBox x:Name="ShortcutList" Style="{StaticResource DeviceListBoxStyle}"
                             ItemContainerStyle="{StaticResource ShortcutItemStyle}"
                             ItemTemplate="{StaticResource ShortcutTemplate}"
                             Margin="0,0,0,6"
                             SelectionChanged="ShortcutList_SelectionChanged"
                             MouseDoubleClick="ShortcutList_MouseDoubleClick"/>

                    <!-- Un clic choisit le sous-dossier, un double-clic y entre. -->
                    <ListBox x:Name="FolderList" Style="{StaticResource DeviceListBoxStyle}"
                             ItemContainerStyle="{StaticResource ShortcutItemStyle}"
                             ItemTemplate="{StaticResource ShortcutTemplate}"
                             Margin="0,0,0,6" Visibility="Collapsed"
                             SelectionChanged="FolderList_SelectionChanged"
                             MouseDoubleClick="FolderList_MouseDoubleClick"/>
                </Grid>
            </DockPanel>
        </ui:CardBorder>
    </DockPanel>
</ui:ChromeWindow>
