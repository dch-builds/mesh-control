<ui:ChromeWindow x:Class="MeshControl.Desktop.DesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bureau à distance — Mesh Control" Height="760" Width="1180"
        MinWidth="900" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Focusable="True">
    <!-- Focusable : en mode onglets, c'est ce conteneur (et non la fenêtre) qui
         reçoit les frappes clavier. -->
    <DockPanel x:Name="RootPanel" Focusable="True"
               PreviewKeyDown="Content_PreviewKeyDown"
               PreviewKeyUp="Content_PreviewKeyUp">
        <!-- Ressources portées par le panneau et non par la fenêtre : en mode
             onglets, c'est lui qui migre vers la fenêtre hôte. -->
        <DockPanel.Resources>
            <!-- Pastille posée sur l'image distante (zoom, vue seule) :
                 cliquable, elle rappelle un état et permet d'en sortir. -->
            <Style x:Key="OverlayChip" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" Background="#D9000000" CornerRadius="8"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter TextElement.Foreground="#E4E6EA"
                                                      TextElement.FontSize="12"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" Foreground="#E4E6EA"
                                               VerticalAlignment="Center" Margin="10,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="#F2000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bouton de la barre flottante du plein écran, sur fond sombre.
                 Non focalisable : le clavier doit rester au panneau, donc à
                 la machine distante. -->
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="#E4E6EA"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OverlayGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </DockPanel.Resources>

        <!-- Barre d'outils. En fenêtre autonome, elle quitte ce panneau pour se
             loger dans la barre de titre (voir MergeToolbarIntoTitleBar) : une
             seule bande au lieu de deux. En mode onglets, elle reste ici. -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{StaticResource CardBrush}" Padding="14,10">
            <Border.Effect>
                <DropShadowEffect Color="#18000000" BlurRadius="8" ShadowDepth="1"
                                  Direction="270" Opacity="0.6"/>
            </Border.Effect>
            <!-- Deux colonnes : le titre absorbe la réduction de largeur (il est
                 tronqué), les contrôles gardent leur taille. Sans colonnes, les
                 deux blocs se superposaient dès que la fenêtre rétrécissait. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Identité de la machine -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9"
                             Fill="{StaticResource OnlineBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="ResolutionText" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="10,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Contrôles. IsHitTestVisibleInChrome : une fois la barre
                     logée dans la barre de titre, le système capterait sinon
                     les clics comme un glisser de fenêtre. Sans effet ailleurs. -->
                <StackPanel x:Name="ToolbarControls" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Libellés retirés au profit d'info-bulles : les valeurs
                         affichées se suffisent, et la barre reste lisible sur
                         une fenêtre étroite. -->
                    <ComboBox x:Name="QualityCombo" Width="104" FontSize="12"
                              VerticalContentAlignment="Center"
                              ToolTip="Qualité d'image"
                              SelectionChanged="QualityCombo_SelectionChanged">
                        <!-- Tag : valeur enregistrée dans les réglages
                             (DefaultDesktopQuality), qui ne suit pas l'ordre de
                             la liste : les modes dépannage et fluide sont venus
                             après. -->
                        <ComboBoxItem Content="Dépannage" Tag="3"
                                      ToolTip="Liaison très lente : compression maximale, image réduite, 5 img/s au plus. « Image nette » (Ctrl+Maj+R) rend le texte lisible"/>
                        <ComboBoxItem Content="Basse" Tag="0"/>
                        <ComboBoxItem Content="Équilibrée" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="Haute" Tag="2"/>
                        <ComboBoxItem Content="Fluide" Tag="4"
                                      ToolTip="Pour suivre une vidéo : 40 img/s et bonne qualité d'image. Demande une bonne connexion"/>
                    </ComboBox>

                    <ComboBox x:Name="FrameRateCombo" Width="104" FontSize="12"
                              VerticalContentAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Fluidité : taux de rafraîchissement de l'écran distant"
                              SelectionChanged="FrameRateCombo_SelectionChanged">
                        <!-- Mêmes valeurs que DesktopSession.FrameRates, en Tag. -->
                        <ComboBoxItem Content="5 img/s" Tag="5"/>
                        <ComboBoxItem Content="10 img/s" Tag="10" IsSelected="True"/>
                        <ComboBoxItem Content="15 img/s" Tag="15"/>
                        <ComboBoxItem Content="20 img/s" Tag="20"/>
                        <ComboBoxItem Content="25 img/s" Tag="25"/>
                        <ComboBoxItem Content="30 img/s" Tag="30"/>
                        <ComboBoxItem Content="40 img/s" Tag="40"/>
                    </ComboBox>

                    <!-- Sélecteur d'écran, réduit à une icône : masqué tant que
                         la machine n'a qu'un écran, donc invisible sur la
                         grande majorité des postes. -->
                    <Button x:Name="DisplayButton" Visibility="Collapsed"
                            Style="{StaticResource ToolButton}"
                            Click="Display_Click" Padding="9,5" Margin="12,0,0,0"
                            ToolTip="Choisir l'écran affiché (Ctrl+Maj+← / →)">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="DisplayMenu" Placement="Bottom"/>
                        </Button.ContextMenu>
                    </Button>

                    <Border Width="1" Background="{StaticResource SeparatorBrush}"
                            Margin="14,2,14,2"/>

                    <CheckBox x:Name="FitCheck" Content="Ajuster" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center" IsChecked="True"
                              Checked="Fit_Changed" Unchecked="Fit_Changed"
                              Margin="0,0,12,0"
                              ToolTip="Ajuster l'image à la fenêtre (Ctrl+Maj+A)"/>

                    <!-- Visible seulement quand la reprise automatique a
                         abandonné : sinon la session se rétablit toute seule. -->
                    <Button x:Name="ReconnectButton" Content="Reconnecter"
                            Style="{StaticResource ToolButton}"
                            Click="Reconnect_Click" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            ToolTip="Relancer la connexion à cette machine"/>

                    <Button x:Name="RefreshButton" Content="Rafraîchir" Style="{StaticResource ToolButton}"
                            Click="Refresh_Click" Margin="0,0,6,0"
                            ToolTip="Redemander une image complète (Ctrl+Maj+R)"/>

                    <!-- Menu de raccourcis clavier envoyés à la machine distante -->
                    <Button x:Name="ShortcutsButton" Content="Raccourcis ▾"
                            Style="{StaticResource ToolButton}"
                            Click="Shortcuts_Click" Margin="0,0,6,0"
                            ToolTip="Combinaisons envoyées à la machine distante (Ctrl+Alt+Suppr : Ctrl+Maj+Suppr)">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ShortcutsMenu" Placement="Bottom"/>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Les deux façons de coller, réunies en un bloc segmenté :
                         chacune à un clic, et visiblement liées.
                         - Coller : presse-papiers distant + Ctrl+V (instantané,
                           repli automatique sur la frappe si besoin) ;
                         - Taper : saisie caractère par caractère, pour les
                           applications qui ignorent Ctrl+V (certains terminaux,
                           consoles, écrans de connexion). Pendant une saisie,
                           le même bouton sert à l'interrompre. -->
                    <Border Background="{StaticResource ControlBrush}" CornerRadius="8"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PasteButton" Content="Coller"
                                    Style="{StaticResource ToolButton}"
                                    Background="Transparent"
                                    Click="Paste_Click"
                                    ToolTip="Coller le presse-papiers local sur la machine distante (Ctrl+Maj+V)"/>
                            <Border Width="1" Margin="0,6" Background="{StaticResource SeparatorBrush}"/>
                            <Button x:Name="PasteTypingButton"
                                    Style="{StaticResource ToolButton}"
                                    Background="Transparent"
                                    Click="PasteAsTyping_Click"
                                    ToolTip="Coller en simulant la frappe : lent, mais fonctionne partout, même là où Ctrl+V est ignoré (Ctrl+Maj+Alt+V)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PasteTypingGlyph" Text="&#xE765;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,1,6,0"/>
                                    <TextBlock x:Name="PasteTypingLabel" Text="Taper"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Margin="0,6" Background="{StaticResource SeparatorBrush}"/>
                            <!-- Interrupteur : synchronisation automatique du
                                 presse-papiers dans les deux sens. Mis en
                                 évidence (bleu) quand il est actif. -->
                            <Button x:Name="ClipboardSyncButton"
                                    Style="{StaticResource ToolButton}"
                                    Background="Transparent"
                                    Click="ClipboardSync_Click" Padding="9,5">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Récupère le presse-papiers de la machine distante -->
                    <Button x:Name="CopyFromRemoteButton" Content="Copier depuis"
                            Style="{StaticResource ToolButton}"
                            Click="CopyFromRemote_Click" Margin="0,0,6,0"
                            ToolTip="Récupérer le presse-papiers de la machine distante (Ctrl+Maj+C)"/>

                    <!-- Capture de l'écran distant -->
                    <Button x:Name="ScreenshotButton" Content="📷"
                            Style="{StaticResource ToolButton}"
                            Click="Screenshot_Click" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="Capturer l'écran distant (Ctrl+Maj+S)"/>

                    <!-- Loupe : on trace un rectangle sur l'écran pour l'agrandir.
                         Un second clic revient à la vue entière. -->
                    <Button x:Name="ZoomButton"
                            Style="{StaticResource ToolButton}"
                            Click="Zoom_Click" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="Agrandir une zone : tracer un rectangle sur l'écran (Ctrl+Maj+Z)">
                        <TextBlock x:Name="ZoomButtonGlyph" Text="&#xE8A3;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>

                    <!-- Vue seule : la souris et le clavier ne partent plus
                         vers la machine. Pour observer sans risque de clic
                         malencontreux. Mis en évidence quand il est actif. -->
                    <Button x:Name="ViewOnlyButton"
                            Style="{StaticResource ToolButton}"
                            Click="ViewOnly_Click" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="Vue seule : observer sans envoyer souris ni clavier (Ctrl+Maj+O)">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>

                    <!-- Secours : débloque un modificateur resté enfoncé côté distant -->
                    <Button x:Name="ReleaseModifiersButton" Content="⌨" Style="{StaticResource ToolButton}"
                            Click="ReleaseModifiers_Click" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="Débloquer le clavier distant : relâche Ctrl, Alt, Maj, Win (Ctrl+Maj+D)"/>

                    <!-- Plein écran : masque barre d'outils, barre d'état et
                         bandeau d'onglets, et retire la bordure de la fenêtre. -->
                    <Button x:Name="FullscreenButton" Content="⛶"
                            Style="{StaticResource ToolButton}"
                            Click="Fullscreen_Click" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="Plein écran (Ctrl+Maj+F)"/>

                    <!-- Alimentation, à portée de main : redémarrer la machine
                         sans repasser par la liste. La session reprend seule au
                         retour de la machine. -->
                    <Button x:Name="PowerButton"
                            Style="{StaticResource ToolButton}"
                            Click="Power_Click" Padding="9,5" Margin="0,0,6,0"
                            ToolTip="Redémarrer, mettre en veille ou éteindre la machine (redémarrage : Ctrl+Maj+B)">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PowerMenu" Placement="Bottom">
                                <MenuItem Header="Redémarrer…" InputGestureText="Ctrl+Maj+B"
                                          Click="Reboot_Click"/>
                                <MenuItem Header="Mettre en veille…" Click="Sleep_Click"/>
                                <MenuItem Header="Éteindre…" Click="PowerOff_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Accès aux autres outils de la machine. Un seul bouton
                         plutôt que trois : la barre est déjà dense. -->
                    <Button x:Name="MoreButton" Content="⋯"
                            Style="{StaticResource ToolButton}"
                            Click="More_Click" Padding="9,5"
                            ToolTip="Autres outils : terminal (Ctrl+Maj+T), fichiers (Ctrl+Maj+E), processus (Ctrl+Maj+P), page web (Ctrl+Maj+W)">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" Placement="Bottom">
                                <!-- Boutons de la barre repliés ici quand la
                                     fenêtre est trop étroite pour les afficher
                                     (voir ApplyToolbarCompactness). -->
                                <MenuItem x:Name="OverflowCopyItem" Visibility="Collapsed"
                                          Header="Copier depuis la machine" InputGestureText="Ctrl+Maj+C"
                                          Click="CopyFromRemote_Click"/>
                                <MenuItem x:Name="OverflowScreenshotItem" Visibility="Collapsed"
                                          Header="Capturer l'écran" InputGestureText="Ctrl+Maj+S"
                                          Click="Screenshot_Click"/>
                                <MenuItem x:Name="OverflowZoomItem" Visibility="Collapsed"
                                          Header="Loupe" InputGestureText="Ctrl+Maj+Z"
                                          Click="Zoom_Click"/>
                                <MenuItem x:Name="OverflowReleaseItem" Visibility="Collapsed"
                                          Header="Débloquer le clavier distant" InputGestureText="Ctrl+Maj+D"
                                          Click="ReleaseModifiers_Click"/>
                                <Separator x:Name="OverflowSeparator" Visibility="Collapsed"/>
                                <MenuItem Header="Terminal" InputGestureText="Ctrl+Maj+T"
                                          Click="OpenTerminal_Click"/>
                                <MenuItem Header="Fichiers" InputGestureText="Ctrl+Maj+E"
                                          Click="OpenFiles_Click"/>
                                <MenuItem Header="Processus…" InputGestureText="Ctrl+Maj+P"
                                          Click="OpenProcesses_Click"/>
                                <Separator/>
                                <MenuItem Header="Page web MeshCentral" InputGestureText="Ctrl+Maj+W"
                                          Click="OpenWebPage_Click"/>
                                <MenuItem Header="Informations système…"
                                          Click="OpenSystemInfo_Click"/>
                                <Separator/>
                                <!-- Sous-menu plutôt qu'un contrôle de plus dans
                                     la barre, déjà dense. -->
                                <MenuItem x:Name="ScaleMenu" Header="Échelle de l'image">
                                    <MenuItem Header="100 % — taille réelle" Tag="100"
                                              IsCheckable="True" Click="Scale_Click"/>
                                    <MenuItem Header="75 %" Tag="75"
                                              IsCheckable="True" Click="Scale_Click"/>
                                    <MenuItem Header="50 % — deux fois moins de données" Tag="50"
                                              IsCheckable="True" Click="Scale_Click"/>
                                    <MenuItem Header="33 % — liaison lente" Tag="33"
                                              IsCheckable="True" Click="Scale_Click"/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <TextBlock x:Name="StatsText" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               MinWidth="70" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre d'état persistante : latence, débit, résolution. Remplace le
             compteur de tuiles, qui relevait du débogage. -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="14,5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="StatusLatency" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" MinWidth="86"
                               ToolTip="Latence aller-retour avec la machine"/>
                    <Border Width="1" Background="{StaticResource SeparatorBrush}"
                            Margin="10,1,10,1"/>
                    <TextBlock x:Name="StatusThroughput" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" MinWidth="92"
                               ToolTip="Débit reçu du flux d'image"/>
                    <Border Width="1" Background="{StaticResource SeparatorBrush}"
                            Margin="10,1,10,1"/>
                    <TextBlock x:Name="StatusResolution" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               ToolTip="Résolution de l'écran distant"/>

                    <!-- Envoi de fichiers déposés sur l'écran : visible le temps
                         du transfert seulement. -->
                    <StackPanel x:Name="TransferPanel" Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Border Width="1" Background="{StaticResource SeparatorBrush}"
                                Margin="10,1,10,1"/>
                        <TextBlock x:Name="StatusTransfer" Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        <Button Content="Annuler" Style="{StaticResource ToolButton}"
                                Click="CancelDrop_Click" Padding="7,1" FontSize="11"
                                Margin="8,0,0,0"
                                ToolTip="Interrompre l'envoi des fichiers déposés"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusTotal" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Opacity="0.7"
                           ToolTip="Volume total reçu depuis le début de la session"/>
            </Grid>
        </Border>

        <!-- Zone d'affichage du bureau distant (fond sombre : met l'écran en valeur) -->
        <!-- Deux conteneurs exclusifs :
             - FitHost (Grid)      : mode « Ajuster » — WPF met l'image à l'échelle
                                     automatiquement et suit la fenêtre nativement.
             - Scroller (ScrollViewer) : mode 1:1 — taille native + défilement. -->
        <!-- AllowDrop : des fichiers glissés depuis l'Explorateur sur l'écran
             distant partent vers la machine (dossier de transfert habituel). -->
        <Grid x:Name="DisplayArea" Background="#1B1D21" AllowDrop="True"
              PreviewMouseMove="DisplayArea_PreviewMouseMove"
              DragEnter="DisplayArea_DragOver" DragOver="DisplayArea_DragOver"
              DragLeave="DisplayArea_DragLeave" Drop="DisplayArea_Drop">
            <!-- ClipToBounds : agrandie par la loupe, l'image déborde de son
                 hôte ; sans découpe, elle recouvrirait les barres. -->
            <Grid x:Name="FitHost" ClipToBounds="True">
                <!-- StretchDirection="Both" : agrandit aussi les petites
                     résolutions, qui restaient sinon minuscules au centre d'une
                     grande fenêtre. Uniform conserve le ratio dans les deux sens. -->
                <Image x:Name="ScreenImage" Focusable="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform" StretchDirection="Both"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MouseMove="Screen_MouseMove"
                       MouseDown="Screen_MouseDown"
                       MouseUp="Screen_MouseUp"
                       MouseWheel="Screen_MouseWheel"
                       LostMouseCapture="Screen_LostMouseCapture"/>
            </Grid>

            <ScrollViewer x:Name="Scroller" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False" Padding="0">
                <Image x:Name="ScreenImageNative" Focusable="False"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MouseMove="Screen_MouseMove"
                       MouseDown="Screen_MouseDown"
                       MouseUp="Screen_MouseUp"
                       MouseWheel="Screen_MouseWheel"
                       LostMouseCapture="Screen_LostMouseCapture"/>
            </ScrollViewer>

            <!-- En plein écran, la barre d'outils disparaît : sans ce rappel,
                 le moyen d'en sortir serait invisible. Échap n'est pas utilisé,
                 la touche devant rester disponible côté distant. -->
            <Border x:Name="FullscreenHint" Visibility="Collapsed"
                    IsHitTestVisible="False" Background="#D9000000"
                    CornerRadius="8" Padding="14,8"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,18,0,0">
                <TextBlock Text="Plein écran — souris en haut de l'écran pour la barre d'outils, Ctrl+Maj+F pour revenir"
                           Foreground="#E4E6EA" FontSize="12"/>
            </Border>

            <!-- Tracé de la zone à agrandir. Fond transparent mais présent :
                 c'est lui qui reçoit la souris, qui ne part donc pas vers la
                 machine distante pendant le tracé. -->
            <Canvas x:Name="ZoomOverlay" Visibility="Collapsed"
                    Background="Transparent" Cursor="Cross"
                    MouseLeftButtonDown="ZoomOverlay_MouseLeftButtonDown"
                    MouseMove="ZoomOverlay_MouseMove"
                    MouseLeftButtonUp="ZoomOverlay_MouseLeftButtonUp"
                    MouseRightButtonDown="ZoomOverlay_MouseRightButtonDown">
                <Rectangle x:Name="ZoomBand" Visibility="Collapsed"
                           Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                           Fill="#260A84FF"/>
            </Canvas>

            <Border x:Name="ZoomHint" Visibility="Collapsed"
                    IsHitTestVisible="False" Background="#D9000000"
                    CornerRadius="8" Padding="14,8"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,18,0,0">
                <TextBlock Text="Tracez la zone à agrandir — Échap ou clic droit pour annuler"
                           Foreground="#E4E6EA" FontSize="12"/>
            </Border>

            <!-- Rappel du zoom en cours, cliquable pour revenir à la vue entière. -->
            <Button x:Name="ZoomBadge" Visibility="Collapsed"
                    Style="{StaticResource OverlayChip}"
                    Click="ZoomBadge_Click"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,14,14,0"
                    ToolTip="Revenir à la vue entière (Ctrl+Maj+Z)"/>

            <!-- Liaison lente repérée : propose le mode dépannage, sans
                 l'imposer. En bas, pour ne pas masquer les rappels du haut. -->
            <Border x:Name="SlowLinkBanner" Visibility="Collapsed"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,8,8,8"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="16,0,16,18">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2"
                                      Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,1,10,0"/>
                    <TextBlock Text="Connexion lente : l'image arrive en retard."
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,14,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="Passer en mode dépannage"
                            Style="{StaticResource AccentToolButton}"
                            Click="SlowLinkSwitch_Click" Margin="0,0,6,0"/>
                    <Button Content="Ignorer" Style="{StaticResource ToolButton}"
                            Click="SlowLinkDismiss_Click"/>
                </StackPanel>
            </Border>

            <!-- Rappel permanent de la vue seule : sans lui, on croirait la
                 session figée. Cliquable pour reprendre la main. -->
            <Button x:Name="ViewOnlyBadge" Visibility="Collapsed"
                    Style="{StaticResource OverlayChip}"
                    Click="ViewOnly_Click"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Margin="14,14,0,0"
                    ToolTip="Reprendre le contrôle (Ctrl+Maj+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock Text="Vue seule" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Barre flottante du plein écran : apparaît quand la souris
                 touche le bord haut de l'écran, disparaît quand elle s'en
                 éloigne. Donne accès aux actions courantes sans quitter le
                 plein écran ni retenir de raccourci. -->
            <Border x:Name="FullscreenBar" Visibility="Collapsed"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="#EB1B1D21" BorderBrush="#33FFFFFF" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10" Padding="8,5"
                    MouseEnter="FullscreenBar_MouseEnter"
                    MouseLeave="FullscreenBar_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2"
                                      Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="FullscreenBarDot" Width="8" Height="8"
                             Fill="{StaticResource OnlineBrush}"
                             VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <TextBlock x:Name="FullscreenBarTitle" Foreground="#E4E6EA"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" MaxWidth="220"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <Border Width="1" Background="#33FFFFFF" Margin="2,5"/>

                    <Button x:Name="BarPasteButton" Style="{StaticResource OverlayButton}"
                            Click="Paste_Click" Margin="4,0,0,0"
                            ToolTip="Coller le presse-papiers local (Ctrl+Maj+V)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" Style="{StaticResource OverlayGlyph}" Margin="0,1,6,0"/>
                            <TextBlock Text="Coller" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BarTypingButton" Style="{StaticResource OverlayButton}"
                            Click="PasteAsTyping_Click"
                            ToolTip="Coller en simulant la frappe (Ctrl+Maj+Alt+V)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BarTypingGlyph" Text="&#xE765;"
                                       Style="{StaticResource OverlayGlyph}" Margin="0,1,6,0"/>
                            <TextBlock x:Name="BarTypingLabel" Text="Taper" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BarSyncButton" Style="{StaticResource OverlayButton}"
                            Click="ClipboardSync_Click" Padding="9,6">
                        <TextBlock Text="&#xE895;" Style="{StaticResource OverlayGlyph}"/>
                    </Button>

                    <Border Width="1" Background="#33FFFFFF" Margin="4,5"/>

                    <Button x:Name="BarShortcutsButton" Style="{StaticResource OverlayButton}"
                            Content="Raccourcis ▾" Click="Shortcuts_Click"
                            ToolTip="Combinaisons envoyées à la machine distante"/>
                    <Button x:Name="BarCtrlAltDelButton" Style="{StaticResource OverlayButton}"
                            Content="Ctrl+Alt+Suppr" Click="CtrlAltDel_Click"
                            ToolTip="Envoyer Ctrl+Alt+Suppr (Ctrl+Maj+Suppr)"/>
                    <Button x:Name="BarViewOnlyButton" Style="{StaticResource OverlayButton}"
                            Click="ViewOnly_Click" Padding="9,6"
                            ToolTip="Vue seule (Ctrl+Maj+O)">
                        <TextBlock Text="&#xE890;" Style="{StaticResource OverlayGlyph}"/>
                    </Button>
                    <Button Style="{StaticResource OverlayButton}"
                            Click="Screenshot_Click" Padding="9,6"
                            ToolTip="Capturer l'écran distant (Ctrl+Maj+S)">
                        <TextBlock Text="&#xE722;" Style="{StaticResource OverlayGlyph}"/>
                    </Button>

                    <Border Width="1" Background="#33FFFFFF" Margin="4,5"/>

                    <Button Style="{StaticResource OverlayButton}"
                            Click="Fullscreen_Click"
                            ToolTip="Quitter le plein écran (Ctrl+Maj+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73F;" Style="{StaticResource OverlayGlyph}" Margin="0,1,6,0"/>
                            <TextBlock Text="Quitter" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Fichiers glissés au-dessus de l'écran : rappelle où ils iront. -->
            <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                  Background="#B3101215">
                <Rectangle Margin="18" RadiusX="12" RadiusY="12"
                           Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                           StrokeDashArray="6 4"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="#E4E6EA" HorizontalAlignment="Center"/>
                    <TextBlock Text="Déposer pour envoyer à la machine"
                               FontSize="16" FontWeight="SemiBold" Foreground="#E4E6EA"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock x:Name="DropDestinationText" FontSize="12"
                               Foreground="#A0A4AB" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</ui:ChromeWindow>
