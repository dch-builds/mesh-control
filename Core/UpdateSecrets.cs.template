namespace MeshControl.Core;

/// <summary>
/// Jeton d'accès en lecture au dépôt privé, pour la vérification des mises à jour.
///
/// AVERTISSEMENT DE SÉCURITÉ
/// -------------------------
/// Ce jeton est compilé dans le binaire : il n'est PAS confidentiel. Toute
/// personne ayant accès à un poste où l'application est installée peut l'extraire
/// (« strings » sur la DLL suffit). Il donne alors un accès en LECTURE au dépôt.
///
/// Conséquences à assumer :
///  - N'utiliser qu'un PAT « fine-grained » restreint au SEUL dépôt mesh-control,
///    avec la permission « Contents: Read only » et rien d'autre.
///  - Ne jamais mettre ici un PAT classique : il porterait les droits sur tous
///    les dépôts du compte.
///  - Prévoir une expiration courte (90 jours) et le renouveler.
///  - En cas de doute sur une fuite, révoquer le jeton immédiatement :
///    https://github.com/settings/personal-access-tokens
///
/// Ce fichier est exclu du dépôt (.gitignore). Un jeton vide désactive
/// simplement la vérification des mises à jour ; l'application fonctionne
/// normalement sans lui.
/// </summary>
internal static class UpdateSecrets
{
    /// <summary>
    /// Dépôt surveillé, au format « propriétaire/nom ».
    /// </summary>
    public const string Repository = "dch-builds/mesh-control";

    /// <summary>
    /// PAT fine-grained, portée « Contents: Read » sur le seul dépôt ci-dessus.
    /// Laisser vide pour désactiver la vérification des mises à jour.
    /// </summary>
    public const string Token = "";

    public static bool IsConfigured => !string.IsNullOrWhiteSpace(Token);
}
