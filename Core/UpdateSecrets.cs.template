namespace MeshControl.Core;

/// <summary>
/// Dépôt où sont publiées les mises à jour.
///
/// Les binaires sont distribués par un dépôt PUBLIC, distinct du dépôt privé qui
/// héberge le code source. L'API GitHub accepte donc les requêtes sans
/// authentification, et plus aucun jeton n'est compilé dans l'application.
///
/// C'était le défaut du dispositif précédent, et il était double. Un PAT embarqué
/// dans le binaire n'est pas confidentiel — « strings » sur la DLL suffit à
/// l'extraire — et celui-ci ouvrait en lecture le dépôt du code source. Il
/// expirait de surcroît tous les 90 jours : passé ce délai, toute installation
/// déployée cessait silencieusement de voir les mises à jour, l'échec
/// d'authentification n'étant visible que dans le journal.
///
/// Si un jeton devait malgré tout être renseigné un jour (dépôt de distribution
/// redevenu privé), n'utiliser qu'un PAT « fine-grained » restreint au SEUL dépôt
/// de distribution, en lecture seule — jamais un PAT classique, qui porterait les
/// droits sur tous les dépôts du compte — et prévoir son renouvellement.
///
/// Sans authentification, GitHub limite à 60 requêtes par heure et par adresse IP,
/// sans commune mesure avec une vérification par démarrage.
///
/// Ce fichier est exclu du dépôt (.gitignore) ; le modèle, lui, y figure.
/// </summary>
internal static class UpdateSecrets
{
    /// <summary>
    /// Dépôt surveillé, au format « propriétaire/nom ». Public : voir ci-dessus.
    /// </summary>
    public const string Repository = "dch-builds/mesh-control-releases";

    /// <summary>
    /// Laisser vide tant que le dépôt de distribution est public.
    /// </summary>
    public const string Token = "";

    /// <summary>
    /// La vérification ne dépend plus d'un jeton, mais du seul dépôt renseigné.
    /// </summary>
    public static bool IsConfigured => !string.IsNullOrWhiteSpace(Repository);
}
