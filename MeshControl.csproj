<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms n'est plus référencé : la zone de notification passe directement
         par Shell_NotifyIcon (voir UI/TrayIcon.cs). Cela évite de charger
         System.Windows.Forms et System.Drawing, soit une vingtaine de mégaoctets
         lus à chaque démarrage pour une simple icône. -->
    <AssemblyName>Mesh Control</AssemblyName>
    <RootNamespace>MeshControl</RootNamespace>
    <ApplicationTitle>Mesh Control</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Point d'entrée écrit à la main (voir App.xaml.cs) plutôt que celui que
         WPF génère. Velopack doit s'amorcer avant toute initialisation WPF : il
         peut détourner le lancement pour appliquer une mise à jour ou exécuter
         un hook, et doit alors rendre la main immédiatement — sans payer le coût
         de chargement du framework. -->
    <StartupObject>MeshControl.App</StartupObject>

    <!-- Métadonnées visibles dans les propriétés du fichier .exe -->
    <Version>1.1.14</Version>
    <FileVersion>1.1.14.0</FileVersion>
    <AssemblyVersion>1.1.14.0</AssemblyVersion>
    <Company>Mesh Control</Company>
    <Product>Mesh Control</Product>
    <Description>Contrôle à distance des postes via MeshCentral</Description>
    <Copyright>© Mesh Control</Copyright>

    <!-- Publication en FICHIERS SÉPARÉS, destinée à un installeur (Inno Setup).
         On évite volontairement PublishSingleFile : celui-ci réextrait tout le
         contenu dans un dossier temporaire à chaque lancement, ce qui ralentit le
         démarrage sans apporter d'intérêt une fois l'application installée.
         Autonome (SelfContained) pour ne dépendre d'aucun runtime .NET sur les postes. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- La troncature est incompatible avec WPF (résolution de types par réflexion
         dans le XAML) : elle provoquerait des plantages à l'exécution. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <!-- Fichiers de langue des messages du framework : inutiles ici, ils
         représentent une part notable du volume. -->
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- App.xaml cesse d'être la définition d'application : c'est elle qui ferait
       générer un Main concurrent du nôtre. Déclarée en Page, elle produit
       toujours InitializeComponent() — donc les ressources et StartupUri — mais
       laisse le point d'entrée à StartupObject ci-dessus. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
