<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms n'est plus référencé : la zone de notification passe directement
         par Shell_NotifyIcon (voir UI/TrayIcon.cs). Cela évite de charger
         System.Windows.Forms et System.Drawing, soit une vingtaine de mégaoctets
         lus à chaque démarrage pour une simple icône. -->
    <AssemblyName>Mesh Control</AssemblyName>
    <RootNamespace>MeshControl</RootNamespace>
    <ApplicationTitle>Mesh Control</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Point d'entrée écrit à la main (voir App.xaml.cs) plutôt que celui que
         WPF génère. Velopack doit s'amorcer avant toute initialisation WPF : il
         peut détourner le lancement pour appliquer une mise à jour ou exécuter
         un hook, et doit alors rendre la main immédiatement — sans payer le coût
         de chargement du framework. -->
    <StartupObject>MeshControl.App</StartupObject>

    <!-- Métadonnées visibles dans les propriétés du fichier .exe -->
    <!-- Version : dans Directory.Build.props, commune à Windows et macOS. -->
    <Company>David CHIESA</Company>
    <Product>Mesh Control</Product>
    <Description>Contrôle à distance des postes via MeshCentral</Description>
    <Copyright>© David CHIESA</Copyright>

    <!-- Publication en FICHIERS SÉPARÉS, que Velopack empaquette ensuite.
         On évite volontairement PublishSingleFile : celui-ci réextrait tout le
         contenu dans un dossier temporaire à chaque lancement, ce qui ralentit le
         démarrage sans apporter d'intérêt une fois l'application installée. Il
         priverait de surcroît les paquets delta de toute prise : un fichier
         unique change en entier dès qu'une ligne change.
         Autonome (SelfContained) pour ne dépendre d'aucun runtime .NET sur les postes. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- La troncature est incompatible avec WPF (résolution de types par réflexion
         dans le XAML) : elle provoquerait des plantages à l'exécution. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Précompilation (ReadyToRun) du code de l'application. Les assemblys du
         framework embarqué le sont déjà ; seules les nôtres partaient encore
         en compilation à la volée au lancement — fenêtre principale, liste des
         appareils, connexion. Le code précompilé reste recompilé à chaud par
         la compilation par paliers, sans perte en régime établi. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Fichiers de langue des messages du framework : inutiles ici, ils
         représentent une part notable du volume. -->
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>

    <!-- Projets voisins (bibliothèque multiplateforme, version macOS) : ils
         vivent sous ce dossier mais ne font pas partie de l'application
         Windows, qui compile les sources partagées directement. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MeshControl.Core\**;MeshControl.Mac\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- App.xaml cesse d'être la définition d'application : c'est elle qui ferait
       générer un Main concurrent du nôtre. Déclarée en Page, elle produit
       toujours InitializeComponent() — donc les ressources et StartupUri — mais
       laisse le point d'entrée à StartupObject ci-dessus. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- app.ico sert déjà d'icône Win32 de l'exécutable (ApplicationIcon plus
       haut). La déclarer en ressource la rend aussi accessible au XAML, pour
       l'afficher dans la barre de titre que l'application dessine elle-même. -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Mentions des composants redistribués (runtime .NET, Velopack) : leurs
       licences MIT exigent qu'elles accompagnent l'application installée. -->
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
