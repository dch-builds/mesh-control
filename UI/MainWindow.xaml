<ui:ChromeWindow x:Class="MeshControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Mesh Control" Height="820" Width="1240"
        MinHeight="440" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico">
    <Grid x:Name="RootGrid">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= En-tête ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <!-- Le nom de l'application vit maintenant dans la barre de titre :
                 l'en-tête ne le répète plus et dit à quel serveur on est relié,
                 ce qui est la seule chose qu'on ait besoin de relire ici. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <!-- État de la liaison : vert connecté, orange en reconnexion
                     ou en alerte. Masqué hors connexion. -->
                <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                         Margin="1,3,10,0" VerticalAlignment="Center"
                         Fill="{StaticResource OnlineBrush}" Visibility="Collapsed"/>
                <!-- Serveur en gras, compte (ou état) en retrait : posés par SetHeader. -->
                <TextBlock x:Name="SubtitleText" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"><Run x:Name="HeaderHostRun"
                    Text="Contrôle à distance" FontWeight="SemiBold"/><Run x:Name="HeaderDetailRun"
                    FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                <!-- Rappel du raccourci de recherche rapide, dessiné comme une
                     touche de clavier. Posé à côté du nom du serveur : seul sur
                     sa ligne, il flottait sans rien pour l'ancrer. -->
                <StackPanel x:Name="HotkeyHintBadge" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="18,3,0,0"
                            ToolTip="Ouvre la recherche rapide depuis n'importe quelle application">
                    <Border Background="{StaticResource ControlBrush}"
                            BorderBrush="{StaticResource SeparatorBrush}"
                            BorderThickness="1,1,1,2" CornerRadius="5" Padding="7,1,7,2">
                        <TextBlock x:Name="HotkeyHintText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="recherche rapide" FontSize="11.5" Margin="7,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions discrètes en haut à droite -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}"
                        Content="Rafraîchir" Click="RefreshButton_Click"
                        Visibility="Collapsed" Margin="0,0,8,0"/>
                <!-- Option discrète : réglages serveur / compte -->
                <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}"
                        Click="SettingsButton_Click" ToolTip="Réglages du serveur et du compte"
                        Padding="9,6">
                    <TextBlock Text="⚙" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Corps ================= -->
        <Grid Grid.Row="1">

            <!-- Vue 0 : choix du serveur (premier démarrage, ou « Changer » depuis
                 la connexion). Aucune adresse n'est présumée : chacun relie
                 l'application à son propre serveur. -->
            <ui:CardBorder x:Name="ServerPanel" Style="{StaticResource Card}" Visibility="Collapsed"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="26,24">
                <StackPanel>
                    <TextBlock x:Name="ServerTitle" Text="Bienvenue" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="Indiquez l'adresse de votre serveur MeshCentral pour commencer."/>

                    <TextBlock Text="Adresse du serveur" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="ServerHostBox" Margin="0,0,0,5"
                             KeyDown="ServerHostBox_KeyDown"/>
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="Par exemple meshcentral.mondomaine.fr, ou 192.168.1.10:4430 si le serveur écoute sur un autre port."/>

                    <CheckBox x:Name="ServerSelfSignedCheck"
                              Content="Le serveur utilise un certificat auto-signé"
                              FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,18"/>

                    <Button x:Name="ServerContinueButton" Style="{StaticResource PrimaryButton}"
                            Content="Continuer" Click="ServerContinue_Click"/>

                    <TextBlock x:Name="ServerStatusText" Style="{StaticResource CaptionText}"
                               Margin="0,14,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </ui:CardBorder>

            <!-- Vue 1 : connexion (affichée si pas d'identifiants mémorisés) -->
            <ui:CardBorder x:Name="LoginPanel" Style="{StaticResource Card}"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="26,24">
                <StackPanel>
                    <TextBlock Text="Connexion" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,3"/>
                    <DockPanel Margin="0,0,0,18">
                        <Button x:Name="ChangeServerButton" DockPanel.Dock="Right"
                                Style="{StaticResource SubtleButton}" Padding="6,0"
                                Content="Changer" VerticalAlignment="Center"
                                Click="ChangeServer_Click"/>
                        <TextBlock x:Name="LoginServerLabel" Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Utilisateur" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="UserBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Mot de passe" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PassBox" Margin="0,0,0,12"
                                 KeyDown="PassBox_KeyDown"/>

                    <!-- Second facteur : masqué tant que le serveur ne l'a pas
                         réclamé. Une fois ce poste mémorisé, il ne réapparaît
                         qu'à l'expiration de l'autorisation. -->
                    <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed"
                                Margin="0,0,0,14">
                        <TextBlock Text="Code à deux facteurs"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TokenBox" Margin="0,0,0,10"
                                 KeyDown="PassBox_KeyDown"/>

                        <!-- Mémoriser le poste suppose de mémoriser la session :
                             la case suit donc « Rester connecté sur ce poste ». -->
                        <CheckBox x:Name="TrustDeviceCheck"
                                  Content="Ne plus demander de code sur ce poste"
                                  IsChecked="True" FontSize="12"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  IsEnabled="{Binding IsChecked, ElementName=RememberCheck}"/>
                        <TextBlock x:Name="TrustDeviceHint" Style="{StaticResource FieldHint}"
                                   Margin="24,4,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="SendCodeButton" Style="{StaticResource SubtleButton}"
                                Content="Recevoir un code par courriel"
                                Margin="0,10,0,0" Padding="12,6"
                                HorizontalAlignment="Left" Visibility="Collapsed"
                                Click="SendCode_Click"/>
                    </StackPanel>

                    <CheckBox x:Name="RememberCheck" Content="Rester connecté sur ce poste"
                              IsChecked="True" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,18"/>

                    <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}"
                            Content="Se connecter" Click="ConnectButton_Click"/>

                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}"
                               Margin="0,14,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </ui:CardBorder>

            <!-- Vue 2 : liste des appareils -->
            <!-- Liste des appareils. Deux dispositions : barre latérale affichée
                 (vues et dossiers à gauche, titre de la vue, lignes en carte), ou
                 masquée (liste dense en colonnes triables). Voir ApplyFolderView. -->
            <Grid x:Name="DevicesPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Volet des dossiers -->
                <ui:CardBorder x:Name="FolderPane" Grid.Column="0" Visibility="Collapsed"
                        Style="{StaticResource Card}" Padding="6" Width="238"
                        Margin="0,0,14,0">
                    <DockPanel>
                        <!-- Filtre des dossiers : sur une trentaine de dossiers,
                             taper trois lettres va plus vite que défiler. -->
                        <Border DockPanel.Dock="Top" Height="32" CornerRadius="8" Margin="2,2,2,6"
                                Background="{StaticResource SubtleFillBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource PlaceholderBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           IsHitTestVisible="False"/>
                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <TextBox x:Name="FolderFilterBox" BorderThickness="0"
                                             Background="Transparent" Padding="0" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             TextChanged="FolderFilterBox_TextChanged"
                                             PreviewKeyDown="FolderFilterBox_PreviewKeyDown"/>
                                    <TextBlock x:Name="FolderFilterPlaceholder" Text="Filtrer les dossiers"
                                               FontSize="12" Foreground="{StaticResource PlaceholderBrush}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="ClearFolderFilterButton" Grid.Column="2"
                                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="9" Width="20" Height="20"
                                        Margin="0,0,6,0" Padding="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Visibility="Collapsed" Click="ClearFolderFilter_Click"
                                        ToolTip="Effacer"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="FolderList"
                                 Style="{StaticResource DeviceListBoxStyle}"
                                 ItemContainerStyle="{StaticResource FolderItemStyle}"
                                 SelectionChanged="FolderList_SelectionChanged"
                                 PreviewMouseRightButtonUp="FolderList_PreviewMouseRightButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Tooltip}" Margin="0,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FolderGlyph" Grid.Column="0" Text="{Binding Glyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{Binding GlyphColor}"
                                                   Opacity="{Binding ContentOpacity}"
                                                   VerticalAlignment="Center" Margin="1,0,10,0"/>
                                        <TextBlock x:Name="FolderName" Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Opacity="{Binding ContentOpacity}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <!-- Compteur en pastille : la part comptée (en ligne,
                                             ou répondant aux filtres) en couleur, le total en
                                             retrait. Plus lisible qu'une jauge sous chaque nom. -->
                                        <Border Grid.Column="2" CornerRadius="9" Padding="7,1,7,2"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{StaticResource SubtleFillBrush}"
                                                Visibility="{Binding CounterVisibility}"
                                                Opacity="{Binding ContentOpacity}">
                                            <TextBlock FontSize="10.5">
                                                <Run Text="{Binding Matching, Mode=OneWay}" FontWeight="Bold"
                                                     Foreground="{Binding CountColor}"/><Run
                                                     Text="{Binding Total, Mode=OneWay, StringFormat=' / {0}'}"
                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- Intitulé de section (« Vues », « Dossiers ») -->
                                        <DataTrigger Binding="{Binding IsSection}" Value="True">
                                            <Setter TargetName="FolderGlyph" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="FolderName" Property="FontSize" Value="11"/>
                                            <Setter TargetName="FolderName" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="FolderName" Property="Opacity" Value="1"/>
                                            <Setter TargetName="FolderName" Property="Foreground"
                                                    Value="{StaticResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </ui:CardBorder>

                <!-- Poignée de redimensionnement du volet, dans l'espace qui le
                     sépare de la liste. -->
                <Thumb x:Name="FolderPaneResizer" Grid.Column="0" Width="10"
                       HorizontalAlignment="Right" Margin="0,0,2,0"
                       Cursor="SizeWE" Visibility="{Binding Visibility, ElementName=FolderPane}"
                       DragDelta="FolderPaneResizer_DragDelta"
                       DragCompleted="FolderPaneResizer_DragCompleted"
                       ToolTip="Tirer pour élargir le volet">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <DockPanel Grid.Column="1">
                <!-- Titre de la vue (barre latérale affichée), avec le compteur -->
                <StackPanel x:Name="SidebarTitleRow" DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="2,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ViewTitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="TitleCountHost" Orientation="Horizontal"
                                VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                </StackPanel>

                <!-- Barre de recherche + filtre + compteur -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <!-- Le champ prend la place libre jusqu'à 576 px ; au-delà,
                         la colonne vide absorbe le reste et le garde à gauche. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" MaxWidth="576"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Champ de recherche : la loupe et le texte vivent DANS le
                         cadre, dont le contour passe à l'accent quand on y tape. -->
                    <Border Grid.Column="0" Height="38" CornerRadius="10"
                            Margin="0,0,16,0"
                            Background="{StaticResource ControlBrush}" BorderThickness="1"
                            Cursor="IBeam" MouseLeftButtonDown="SearchFrame_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ScrollThumbBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <!-- Champ sans bordure : le cadre est porté par le Border -->
                                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="0" FontSize="13.5"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="Rechercher par nom, adresse IP, système ou utilisateur"
                                           FontSize="13.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource PlaceholderBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Raccourci rappelé tant que le champ est vide -->
                            <Border x:Name="SearchShortcutHint" Grid.Column="2" Margin="0,0,9,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False"
                                    Background="{StaticResource SubtleFillBrush}"
                                    BorderBrush="{StaticResource SeparatorBrush}"
                                    BorderThickness="1,1,1,2" CornerRadius="5" Padding="6,0,6,1">
                                <TextBlock Text="Ctrl F" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>

                            <!-- Effacer la recherche -->
                            <Button x:Name="ClearSearchButton" Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Content="&#xE711;" Margin="0,0,6,0"
                                    Visibility="Collapsed" Click="ClearSearch_Click"
                                    ToolTip="Effacer (Échap)"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="ToolbarRight" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                        <!-- Envoi groupé : choisir des fichiers et plusieurs machines -->
                        <Button x:Name="SendFilesButton" Style="{StaticResource AccentToolButton}"
                                Click="SendFiles_Click" Margin="12,0,0,0" Padding="10,5"
                                ToolTip="Envoyer des fichiers vers une ou plusieurs machines — ou glissez-les sur une machine de la liste">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Envoyer des fichiers" FontSize="11.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Ordre des machines dans chaque dossier -->
                        <Button x:Name="SortButton" Style="{StaticResource ToolButton}"
                                Click="SortButton_Click" Margin="12,0,0,0" Padding="9,5"
                                ToolTip="Trier les machines">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SortLabel" Text="Nom" FontSize="11.5"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SortMenu">
                                    <MenuItem Header="Nom" Tag="0" IsCheckable="True" Click="SortChoice_Click"/>
                                    <MenuItem Header="En ligne d'abord" Tag="1" IsCheckable="True" Click="SortChoice_Click"/>
                                    <MenuItem Header="Dernière présence" Tag="2" IsCheckable="True" Click="SortChoice_Click"/>
                                    <MenuItem Header="Système" Tag="3" IsCheckable="True" Click="SortChoice_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Bascule entre la liste groupée et la vue à deux volets -->
                        <Button x:Name="ToggleViewButton" Style="{StaticResource ToolButton}"
                                Click="ToggleView_Click" Margin="12,0,0,0"
                                Padding="8,5" ToolTip="Afficher les dossiers à gauche">
                            <TextBlock x:Name="ToggleViewGlyph" Text="&#xE8A4;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <!-- Replier / déplier tous les dossiers -->
                        <Button x:Name="ToggleGroupsButton" Style="{StaticResource ToolButton}"
                                Click="ToggleGroups_Click" Margin="12,0,0,0"
                                Padding="8,5" FontSize="11"
                                ToolTip="Replier tous les dossiers">
                            <TextBlock x:Name="ToggleGroupsGlyph" Text="&#xE70E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Filtres rapides : une pastille par critère, avec son compteur.
                     Garnies par code (BuildFilterChips) ; une pastille dont le
                     compteur tombe à zéro disparaît, sauf si elle est active. -->
                <WrapPanel x:Name="FilterChipsPanel" DockPanel.Dock="Top" Margin="0,-2,0,12"/>

                <!-- Carte contenant la liste -->
                <ui:CardBorder Style="{StaticResource Card}" Padding="6">
                    <DockPanel>
                    <!-- Sélection multiple (Ctrl+clic, Maj+clic, Ctrl+A) : actions
                         groupées. N'apparaît qu'à partir de deux machines. -->
                    <Border x:Name="SelectionBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                            Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                            Padding="12,6,6,6" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Content="&#xE711;" Margin="4,0,0,0"
                                    Click="ClearSelection_Click" ToolTip="Désélectionner (Échap)"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BulkWakeButton" Style="{StaticResource ToolButton}"
                                        Padding="10,5" Margin="0,0,6,0" Content="Réveiller"
                                        Click="BulkWake_Click"
                                        ToolTip="Envoyer un signal Wake-on-LAN aux machines hors ligne"/>
                                <Button x:Name="BulkRebootButton" Style="{StaticResource ToolButton}"
                                        Padding="10,5" Margin="0,0,6,0" Content="Redémarrer…"
                                        Click="BulkReboot_Click"/>
                                <Button x:Name="BulkPowerOffButton" Style="{StaticResource ToolButton}"
                                        Padding="10,5" Margin="0,0,6,0" Content="Éteindre…"
                                        Click="BulkPowerOff_Click"/>
                                <Button x:Name="BulkFavoriteButton" Style="{StaticResource ToolButton}"
                                        Padding="10,5" Margin="0,0,6,0" Content="Ajouter aux favoris"
                                        Click="BulkFavorite_Click"/>
                                <Button x:Name="BulkSendFilesButton" Style="{StaticResource AccentToolButton}"
                                        Padding="10,5" Click="BulkSendFiles_Click"
                                        ToolTip="Envoyer des fichiers aux machines en ligne de la sélection">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Envoyer des fichiers" FontSize="11.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="SelectionText" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        </DockPanel>
                    </Border>
                    <!-- En-têtes de la liste en colonnes (barre latérale masquée).
                         Mêmes colonnes que DeviceColumnsTemplate ; la marge droite
                         suit la barre de défilement (UpdateColumnHeaderMargin). -->
                    <Border x:Name="ColumnHeader" DockPanel.Dock="Top" Visibility="Collapsed"
                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                            Margin="0,2,0,4" Padding="10,4,10,7">
                        <Grid TextElement.FontSize="11.5"
                              TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Tag="0"
                                        Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="ColumnHeader_Click" ToolTip="Trier par nom">
                                <TextBlock Text="Nom"/>
                                <TextBlock x:Name="SortArrowName" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" Margin="6,1,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Tag="3"
                                        Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="ColumnHeader_Click" ToolTip="Trier par système">
                                <TextBlock Text="Système"/>
                                <TextBlock x:Name="SortArrowSystem" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" Margin="6,1,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="Adresse IP"/>
                            <TextBlock Grid.Column="4" Text="Utilisateur"/>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Tag="2"
                                        Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="ColumnHeader_Click"
                                        ToolTip="Trier par dernière présence (en ligne d'abord)">
                                <TextBlock Text="Vu"/>
                                <TextBlock x:Name="SortArrowSeen" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" Margin="6,1,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid>
                    <ListBox x:Name="DeviceList"
                             Style="{StaticResource DeviceListBoxStyle}"
                             ItemContainerStyle="{StaticResource DeviceItemStyle}"
                             SelectionMode="Extended"
                             SelectionChanged="DeviceList_SelectionChanged"
                             PreviewMouseLeftButtonDown="DeviceList_PreviewMouseLeftButtonDown"
                             ContextMenuOpening="DeviceList_ContextMenuOpening"
                             PreviewTextInput="DeviceList_PreviewTextInput"
                             MouseDoubleClick="DeviceList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="DeviceList_PreviewMouseRightButtonDown"
                             AllowDrop="True" DragOver="DeviceList_DragOver"
                             Drop="DeviceList_Drop">
                        <!-- Clic droit : actions sur la machine (le clic gauche/double
                             ouvre directement le bureau à distance). -->
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="DeviceMenu" Opened="DeviceMenu_Opened">
                                <MenuItem x:Name="MenuDesktop" Header="Bureau à distance"
                                          InputGestureText="Entrée"
                                          FontWeight="SemiBold" Click="MenuDesktop_Click"/>
                                <MenuItem x:Name="MenuTerminal" Header="Terminal"
                                          InputGestureText="Ctrl+T"
                                          Click="MenuTerminal_Click"
                                          ToolTip="Invite de commandes / PowerShell via l'agent"/>
                                <MenuItem x:Name="MenuFiles" Header="Fichiers"
                                          InputGestureText="Ctrl+E"
                                          Click="MenuFiles_Click"
                                          ToolTip="Parcourir et transférer des fichiers"/>
                                <MenuItem x:Name="MenuSendFiles" Header="Envoyer des fichiers…"
                                          Click="MenuSendFiles_Click"
                                          ToolTip="Vers cette machine et d'autres, en parallèle"/>
                                <MenuItem x:Name="MenuSsh" Header="Terminal SSH"
                                          Click="MenuSsh_Click"
                                          ToolTip="Nécessite SSH activé sur le serveur MeshCentral"/>
                                <Separator/>
                                <MenuItem x:Name="MenuWake" Header="Réveiller (Wake-on-LAN)"
                                          Click="MenuWake_Click"/>
                                <MenuItem x:Name="MenuWatch" Header="Me prévenir à son retour"
                                          Click="MenuWatch_Click"
                                          ToolTip="Notification Windows dès que la machine se reconnecte"/>
                                <MenuItem x:Name="MenuReboot" Header="Redémarrer…"
                                          Click="MenuReboot_Click"/>
                                <MenuItem x:Name="MenuSleep" Header="Mettre en veille…"
                                          Click="MenuSleep_Click"/>
                                <MenuItem x:Name="MenuPowerOff" Header="Éteindre…"
                                          Click="MenuPowerOff_Click"/>
                                <Separator x:Name="MenuToolsSeparator"/>
                                <MenuItem x:Name="MenuProcesses" Header="Processus…"
                                          Click="MenuProcesses_Click"
                                          ToolTip="Voir et arrêter les processus de la machine"/>
                                <MenuItem x:Name="MenuOpenUrl" Header="Ouvrir une URL…"
                                          Click="MenuOpenUrl_Click"
                                          ToolTip="Lancer le navigateur de la machine sur une adresse"/>
                                <Separator/>
                                <MenuItem x:Name="MenuFavorite" Header="Ajouter aux favoris"
                                          Click="MenuFavorite_Click"/>
                                <MenuItem x:Name="MenuShare" Header="Partager un lien…"
                                          Click="MenuShare_Click"
                                          ToolTip="Créer un lien public temporaire (et son code iframe)"/>
                                <MenuItem x:Name="MenuRename" Header="Renommer…"
                                          InputGestureText="F2"
                                          Click="MenuRename_Click"
                                          ToolTip="Changer le nom affiché dans MeshCentral"/>
                                <MenuItem x:Name="MenuCopyName" Header="Copier le nom"
                                          Click="MenuCopyName_Click"/>
                                <MenuItem x:Name="MenuInfo" Header="Informations système…"
                                          Click="MenuInfo_Click"
                                          ToolTip="Processeur, mémoire, disques, BIOS"/>
                                <MenuItem x:Name="MenuWebPage" Header="Ouvrir la page web…"
                                          InputGestureText="Ctrl+Maj+W"
                                          Click="MenuWebPage_Click"
                                          ToolTip="Voir cette machine dans MeshCentral"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>


                        <!-- Liste plate : les en-têtes de dossier sont des lignes
                             (GroupHeaderRow), chaque type ayant son modèle. Le
                             regroupement de WPF régénérait tous les groupes à
                             chaque filtrage, jusqu'à 380 ms sur un grand parc. -->
                        <ListBox.Resources>
                            <DataTemplate x:Key="GroupHeaderTemplate">
                                <!-- Clic géré par DeviceList_PreviewMouseLeftButtonDown -->
                                <Border HorizontalAlignment="Left" CornerRadius="6"
                                        Padding="7,4" Cursor="Hand"
                                        ToolTip="Replier ou déplier ce dossier">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SubtleFillBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ChevronGlyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,1,8,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count, StringFormat=' ({0})'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Ligne en carte (barre latérale affichée). L'état tient en
                                 un point à droite (StatusDot) ; le nom s'affiche en deux
                                 temps, code puis libellé (Highlight.SplitLabel). -->
                            <DataTemplate x:Key="DeviceCardTemplate">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pastille d'icône du système -->
                                    <Grid x:Name="IconPart" Grid.Column="0"
                                          Width="{DynamicResource DeviceIconSize}"
                                          Height="{DynamicResource DeviceIconSize}"
                                          Margin="0,0,12,0">
                                        <Border Background="{Binding OsGlyphBackground}"
                                                CornerRadius="10"/>
                                        <TextBlock Text="{Binding OsGlyph}" FontSize="17"
                                                   Foreground="{Binding OsGlyphColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Nom + description, surlignés par ui:Highlight -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NameText"
                                                   ui:Highlight.Text="{Binding Name}"
                                                   ui:Highlight.SplitLabel="True"
                                                   FontSize="{DynamicResource DeviceNameSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock ui:Highlight.Text="{Binding Subtitle}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Actions rapides, montrées au survol -->
                                        <StackPanel x:Name="HoverActions" Orientation="Horizontal"
                                                    Visibility="Collapsed" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding RemoteActionsVisibility}">
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xE7F4;" Tag="{Binding}"
                                                        CommandParameter="Desktop" Click="RowAction_Click"
                                                        ToolTip="Bureau à distance"/>
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xE756;" Tag="{Binding}"
                                                        CommandParameter="Terminal" Click="RowAction_Click"
                                                        ToolTip="Terminal"/>
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xF12B;" Tag="{Binding}"
                                                        CommandParameter="Files" Click="RowAction_Click"
                                                        ToolTip="Fichiers"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    Content="&#xE7E8;" Tag="{Binding}"
                                                    CommandParameter="Wake" Click="RowAction_Click"
                                                    Visibility="{Binding WakeActionVisibility}"
                                                    ToolTip="Réveiller (Wake-on-LAN)"/>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    Content="{Binding WatchGlyph}" Tag="{Binding}"
                                                    CommandParameter="Watch" Click="RowAction_Click"
                                                    Visibility="{Binding WakeActionVisibility}"
                                                    ToolTip="{Binding WatchTooltip}"/>
                                        </StackPanel>

                                        <!-- Utilisateur MeshCentral connecté : ses initiales -->
                                        <Border Style="{StaticResource SessionAvatar}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding SessionInitials}" FontSize="9.5"
                                                       FontWeight="SemiBold" Margin="5,0"
                                                       Foreground="{Binding SessionAvatarForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Dernière présence, qui vieillit en couleur -->
                                        <TextBlock x:Name="PresenceBlock" Text="{Binding PresenceText}"
                                                   Foreground="{Binding PresenceColor}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   ToolTip="Dernière connexion au serveur"/>

                                        <!-- État : un point, ou la cloche d'une alerte posée -->
                                        <Grid Width="14" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource StatusDot}"
                                                     Visibility="{Binding StatusDotVisibility}"
                                                     ToolTip="{Binding StatusTooltip}"/>
                                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding WatchIndicatorVisibility}"
                                                       ToolTip="Vous serez prévenu dès son retour en ligne"/>
                                        </Grid>

                                        <Button Content="{Binding FavoriteGlyph}"
                                                Foreground="{Binding FavoriteColor}"
                                                FontSize="15" Width="26" Height="26"
                                                Padding="0" Margin="6,0,2,0" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Click="Favorite_Click"
                                                ToolTip="Épingler / retirer des favoris"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                          RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="HoverActions" Property="Visibility" Value="Visible"/>
                                        <!-- Les actions rapides apparaissent en fondu -->
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverActions"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter TargetName="PresenceBlock" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter TargetName="IconPart" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="NameText" Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <!-- Ligne en colonnes (barre latérale masquée). Mêmes
                                 colonnes que l'en-tête ColumnHeader. -->
                            <DataTemplate x:Key="DeviceColumnsTemplate">
                                <Grid MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="2.4*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="12" HorizontalAlignment="Left"
                                          VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDot}"
                                                 Visibility="{Binding StatusDotVisibility}"
                                                 ToolTip="{Binding StatusTooltip}"/>
                                        <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding WatchIndicatorVisibility}"
                                                   ToolTip="Vous serez prévenu dès son retour en ligne"/>
                                    </Grid>

                                    <TextBlock x:Name="NameText" Grid.Column="1"
                                               ui:Highlight.Text="{Binding Name}"
                                               ui:Highlight.SplitLabel="True"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" ui:Highlight.Text="{Binding OsDisplay}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <!-- Chasse fixe : les adresses s'alignent d'une ligne à l'autre -->
                                    <TextBlock Grid.Column="3" ui:Highlight.Text="{Binding IpText}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Style="{StaticResource SessionAvatar}" Margin="0,0,7,0">
                                            <TextBlock Text="{Binding SessionInitials}" FontSize="9.5"
                                                       FontWeight="SemiBold" Margin="5,0"
                                                       Foreground="{Binding SessionAvatarForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SessionLabel}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding PresenceShort}"
                                               Foreground="{Binding PresenceColor}" FontSize="11.5"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding PresenceText}"/>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel x:Name="HoverActions" Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding RemoteActionsVisibility}">
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xE7F4;" Tag="{Binding}" Width="28" Height="26"
                                                        CommandParameter="Desktop" Click="RowAction_Click"
                                                        ToolTip="Bureau à distance"/>
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xE756;" Tag="{Binding}" Width="28" Height="26"
                                                        CommandParameter="Terminal" Click="RowAction_Click"
                                                        ToolTip="Terminal"/>
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xF12B;" Tag="{Binding}" Width="28" Height="26"
                                                        CommandParameter="Files" Click="RowAction_Click"
                                                        ToolTip="Fichiers"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    Content="&#xE7E8;" Tag="{Binding}" Width="28" Height="26"
                                                    CommandParameter="Wake" Click="RowAction_Click"
                                                    Visibility="{Binding WakeActionVisibility}"
                                                    ToolTip="Réveiller (Wake-on-LAN)"/>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    Content="{Binding WatchGlyph}" Tag="{Binding}" Width="28" Height="26"
                                                    CommandParameter="Watch" Click="RowAction_Click"
                                                    Visibility="{Binding WakeActionVisibility}"
                                                    ToolTip="{Binding WatchTooltip}"/>
                                        </StackPanel>
                                        <Button Content="{Binding FavoriteGlyph}"
                                                Foreground="{Binding FavoriteColor}"
                                                FontSize="14" Width="24" Height="24"
                                                Padding="0" Margin="2,0,0,0" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Click="Favorite_Click"
                                                ToolTip="Épingler / retirer des favoris"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                          RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="HoverActions" Property="Visibility" Value="Visible"/>
                                        <!-- Les actions rapides apparaissent en fondu -->
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverActions"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter TargetName="NameText" Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- Liste vide : dire pourquoi, et offrir la sortie. -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="EmptyStateTitle" Text="Aucune machine ne correspond"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateDetail" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="340" Margin="0,4,0,0"/>
                        <Button x:Name="EmptyStateClearButton" Style="{StaticResource AccentToolButton}"
                                Content="Effacer la recherche et les filtres"
                                HorizontalAlignment="Center" Padding="12,6" Margin="0,14,0,0"
                                Click="ClearFilters_Click"/>
                    </StackPanel>
                    </Grid>
                    </DockPanel>
                </ui:CardBorder>
                </DockPanel>
            </Grid>

            <!-- Vue 3 : chargement. Des lignes en squelette qui pulsent : la
                 liste arrive, on voit déjà sa forme. -->
            <ui:CardBorder x:Name="LoadingPanel" Visibility="Collapsed"
                           Style="{StaticResource Card}" Padding="22,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="Connexion au serveur…" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="LoadingDetail" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.45" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="260" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="180" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="220" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="150" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="300" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="200" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="240" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="130" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="280" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="210" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="200" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="160" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SubtleFillHoverBrush}"/>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <Border Width="250" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                        Background="{StaticResource SubtleFillHoverBrush}"/>
                                <Border Width="170" Height="8" CornerRadius="4" HorizontalAlignment="Left" Margin="0,7,0,0"
                                        Background="{StaticResource SubtleFillBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ui:CardBorder>
        </Grid>
    </Grid>

    <!-- ================= Bandeau de confirmation ================= -->
    <!-- Les confirmations d'action s'écrivaient auparavant dans le compteur
         d'appareils, que le prochain événement du serveur réécrivait dans la
         seconde : le message disparaissait avant d'avoir été lu. -->
    <Border x:Name="ToastBanner" Visibility="Collapsed" IsHitTestVisible="False"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,28" CornerRadius="9" Padding="16,11"
            Background="#F21C1C1E" Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="#44000000" BlurRadius="18" ShadowDepth="2"
                              Direction="270" Opacity="0.8"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="✓" FontSize="13" FontWeight="SemiBold"
                       Foreground="#34C759" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="White"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
        </StackPanel>
    </Border>

    <!-- ================= Voile ================= -->
    <!-- Assombrit le contenu et capte le clic pour fermer le volet. -->
    <Border x:Name="SettingsScrim" Background="#40000000" Visibility="Collapsed"
            Opacity="0" MouseLeftButtonDown="SettingsScrim_Click"/>

    <!-- ================= Volet des réglages ================= -->
    <Border x:Name="SettingsPanel" Width="420" HorizontalAlignment="Right"
            Background="{StaticResource WindowBackgroundBrush}"
            Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="24" ShadowDepth="0"
                              Direction="180" Opacity="0.9"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SettingsTransform" X="420"/>
        </Border.RenderTransform>

        <DockPanel>
            <!-- En-tête du volet -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                    Padding="20,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Réglages" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SettingsSubtitle" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ToolButton}" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,4" FontSize="12" Click="CloseSettings_Click"
                            ToolTip="Fermer (Échap)"/>
                </Grid>
            </Border>

            <!-- Pied : actions -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <TextBlock x:Name="SettingsFeedback" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Style="{StaticResource ToolButton}"
                                Padding="16,8" Margin="0,0,8,0" Click="CloseSettings_Click"/>
                        <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}"
                                Padding="18,8" Click="SaveSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenu défilant -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,18,20">
                <StackPanel>

                    <!-- Bureau à distance -->
                    <TextBlock Text="Bureau à distance" Style="{StaticResource PanelSectionTitle}"/>
                    <TextBlock Text="Valeurs appliquées à chaque nouvelle session."
                               Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="Qualité d'image" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultQualityCombo" FontSize="12"
                                      VerticalContentAlignment="Center" Margin="0,0,0,14">
                                <!-- Tag : valeur enregistrée (DefaultDesktopQuality). -->
                                <ComboBoxItem Content="Dépannage — liaison très lente" Tag="3"/>
                                <ComboBoxItem Content="Basse — réseau lent" Tag="0"/>
                                <ComboBoxItem Content="Équilibrée" Tag="1" IsSelected="True"/>
                                <ComboBoxItem Content="Haute — image nette" Tag="2"/>
                                <ComboBoxItem Content="Fluide — vidéo" Tag="4"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,-10,0,14"
                                       Text="Dépannage : compression maximale, image réduite et 5 img/s au plus, pour garder la main sur une connexion faible. Fluide : 40 img/s en bonne qualité, pour suivre une vidéo."/>

                            <TextBlock Text="Fluidité" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultFrameRateCombo" FontSize="12"
                                      VerticalContentAlignment="Center">
                                <!-- Mêmes valeurs que DesktopSession.FrameRates. -->
                                <ComboBoxItem Content="5 images/s" Tag="5"/>
                                <ComboBoxItem Content="10 images/s" Tag="10" IsSelected="True"/>
                                <ComboBoxItem Content="15 images/s" Tag="15"/>
                                <ComboBoxItem Content="20 images/s" Tag="20"/>
                                <ComboBoxItem Content="25 images/s" Tag="25"/>
                                <ComboBoxItem Content="30 images/s" Tag="30"/>
                                <ComboBoxItem Content="40 images/s" Tag="40"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Au-delà de 30 img/s, l'agent et le réseau deviennent souvent le facteur limitant."/>

                            <TextBlock Text="Échelle de l'image"
                                       Style="{StaticResource CaptionText}" Margin="0,14,0,5"/>
                            <ComboBox x:Name="DefaultScaleCombo">
                                <ComboBoxItem Content="100 % — taille réelle" Tag="100" IsSelected="True"/>
                                <ComboBoxItem Content="75 %" Tag="75"/>
                                <ComboBoxItem Content="50 %" Tag="50"/>
                                <ComboBoxItem Content="33 %" Tag="33"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="L'agent encode moins de pixels : c'est le réglage le plus efficace sur les liaisons lentes. Modifiable par session dans le menu « ⋯ »."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <CheckBox x:Name="DefaultFitCheck"
                                      Content="Ajuster l'écran à la fenêtre"/>

                            <TextBlock Text="Ouverture des sessions"
                                       Style="{StaticResource CaptionText}" Margin="0,14,0,5"/>
                            <ComboBox x:Name="DesktopOpenModeCombo">
                                <ComboBoxItem Content="Fenêtre habituelle" IsSelected="True"/>
                                <ComboBoxItem Content="Plein écran fenêtré (agrandie)"/>
                                <ComboBoxItem Content="Plein écran"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="En plein écran : souris en haut de l'écran pour la barre d'outils, Ctrl+Maj+F pour revenir."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <CheckBox x:Name="TabbedSessionsCheck"
                                      Content="Regrouper les sessions en onglets"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Décochez pour ouvrir chaque session dans sa propre fenêtre. S'applique aux nouvelles sessions."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <TextBlock Text="Densité de la liste"
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="DensityCombo"
                                      SelectionChanged="DensityCombo_SelectionChanged">
                                <ComboBoxItem Content="Compact"/>
                                <ComboBoxItem Content="Normal" IsSelected="True"/>
                                <ComboBoxItem Content="Confortable"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Le mode compact affiche davantage de machines à l'écran."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <CheckBox x:Name="DarkModeCheck" Content="Thème sombre"
                                      Checked="DarkMode_Changed" Unchecked="DarkMode_Changed"/>
                            <TextBlock x:Name="DarkModeHint" Style="{StaticResource FieldHint}"
                                       Margin="24,4,0,0"
                                       Text="Pour toutes les fenêtres de l'application. S'applique au prochain démarrage."/>
                            <Button x:Name="RestartForThemeButton" Style="{StaticResource SubtleButton}"
                                    Content="Redémarrer maintenant" HorizontalAlignment="Left"
                                    Margin="18,4,0,0" Visibility="Collapsed"
                                    Click="RestartForTheme_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Recherche rapide -->
                    <TextBlock Text="Recherche rapide" Style="{StaticResource PanelSectionTitle}"/>
                    <TextBlock Text="Ouvre une palette de recherche par-dessus vos autres applications."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <CheckBox x:Name="QuickSearchCheck"
                                      Content="Activer le raccourci global"
                                      Checked="QuickSearch_Changed" Unchecked="QuickSearch_Changed"
                                      Margin="0,0,0,14"/>
                            <TextBlock Text="Raccourci clavier" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HotkeyBox" IsReadOnly="True" Cursor="Hand"
                                     FontSize="12" TextAlignment="Center"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Cliquez puis pressez la combinaison voulue (avec Ctrl, Alt, Maj ou Win)."/>
                            <TextBlock x:Name="HotkeyWarning" Style="{StaticResource FieldHint}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Comportement -->
                    <TextBlock Text="Comportement" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <CheckBox x:Name="TrayCheck"
                                      Content="Garder l'application dans la zone de notification"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,14"
                                       Text="La croix réduit l'application au lieu de la quitter."/>

                            <CheckBox x:Name="AutoStartCheck" Content="Démarrer avec Windows"
                                      Margin="0,0,0,12"/>
                            <CheckBox x:Name="StartMinimizedCheck"
                                      Content="Démarrer réduit dans la zone de notification"/>
                            <TextBlock x:Name="StartupWarning" Style="{StaticResource FieldHint}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Serveur -->
                    <TextBlock Text="Serveur" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HostBox" Margin="0,0,0,14"/>
                            <CheckBox x:Name="SelfSignedCheck"
                                      Content="Autoriser un certificat auto-signé"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Le certificat présenté à la première connexion est retenu ; un certificat différent sera ensuite refusé."/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Modifier l'adresse impose de se reconnecter."/>
                        </StackPanel>
                    </Border>

                    <!-- Compte -->
                    <TextBlock Text="Compte" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <TextBlock x:Name="AccountText" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <CheckBox x:Name="RememberSettingCheck"
                                      Content="Mémoriser les identifiants"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Le mot de passe est chiffré pour votre session Windows."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <!-- Second facteur : état de l'autorisation de ce poste -->
                            <TextBlock Text="Code à deux facteurs"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TrustStateText" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TrustDeviceButton"
                                        Content="Autoriser ce poste sans limite"
                                        Style="{StaticResource ToolButton}"
                                        Click="TrustDevice_Click" Padding="14,7"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ForgetDeviceButton" Content="Oublier ce poste"
                                        Style="{StaticResource ToolButton}"
                                        Click="ForgetDevice_Click" Padding="14,7"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="Un jeton de connexion propre à ce poste remplace le code à deux facteurs et n'expire pas. Il se révoque ici, ou depuis « Mon compte » sur le serveur."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <Button x:Name="LogoutButton" Content="Se déconnecter"
                                    Style="{StaticResource ToolButton}"
                                    Click="Logout_Click" Padding="14,7"
                                    HorizontalAlignment="Left"
                                    Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Ferme la session et efface le mot de passe mémorisé."/>
                        </StackPanel>
                    </Border>

                    <!-- Mises à jour -->
                    <TextBlock Text="Mises à jour" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <CheckBox x:Name="CheckUpdatesCheck"
                                      Content="Rechercher les mises à jour au démarrage"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,14"
                                       Text="L'installation ferme puis relance l'application."/>
                            <Button Content="Rechercher maintenant"
                                    Style="{StaticResource ToolButton}" Click="CheckUpdates_Click"
                                    Padding="12,7" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic -->
                    <TextBlock Text="Diagnostic" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <CheckBox x:Name="VerboseLogCheck" Content="Journal détaillé"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,14"
                                       Text="Enregistre aussi les échanges de protocole. Plus volumineux."/>
                            <Button Content="Ouvrir le dossier des journaux"
                                    Style="{StaticResource ToolButton}" Click="OpenLogs_Click"
                                    Padding="12,7" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

    </Grid>
</ui:ChromeWindow>
