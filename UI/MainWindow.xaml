<ui:ChromeWindow x:Class="MeshControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Mesh Control" Height="700" Width="980"
        MinHeight="440" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico">
    <Grid x:Name="RootGrid">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= En-tête ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <!-- Le nom de l'application vit maintenant dans la barre de titre :
                 l'en-tête ne le répète plus et dit à quel serveur on est relié,
                 ce qui est la seule chose qu'on ait besoin de relire ici. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SubtitleText" Text="Contrôle à distance"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <!-- Rappel du raccourci de recherche rapide. Posé à côté du nom
                     du serveur plutôt qu'en dessous : seul sur sa ligne, il
                     flottait sans rien pour l'ancrer. -->
                <Border x:Name="HotkeyHintBadge" Background="{StaticResource SubtleFillBrush}" CornerRadius="6"
                        Padding="8,3" VerticalAlignment="Center" Margin="13,3,0,0">
                    <TextBlock x:Name="HotkeyHintText" FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Actions discrètes en haut à droite -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}"
                        Content="Rafraîchir" Click="RefreshButton_Click"
                        Visibility="Collapsed" Margin="0,0,8,0"/>
                <!-- Option discrète : réglages serveur / compte -->
                <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}"
                        Click="SettingsButton_Click" ToolTip="Réglages du serveur et du compte"
                        Padding="9,6">
                    <TextBlock Text="⚙" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Corps ================= -->
        <Grid Grid.Row="1">

            <!-- Vue 0 : choix du serveur (premier démarrage, ou « Changer » depuis
                 la connexion). Aucune adresse n'est présumée : chacun relie
                 l'application à son propre serveur. -->
            <ui:CardBorder x:Name="ServerPanel" Style="{StaticResource Card}" Visibility="Collapsed"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="26,24">
                <StackPanel>
                    <TextBlock x:Name="ServerTitle" Text="Bienvenue" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="Indiquez l'adresse de votre serveur MeshCentral pour commencer."/>

                    <TextBlock Text="Adresse du serveur" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="ServerHostBox" Margin="0,0,0,5"
                             KeyDown="ServerHostBox_KeyDown"/>
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="Par exemple meshcentral.mondomaine.fr, ou 192.168.1.10:4430 si le serveur écoute sur un autre port."/>

                    <CheckBox x:Name="ServerSelfSignedCheck"
                              Content="Le serveur utilise un certificat auto-signé"
                              FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,18"/>

                    <Button x:Name="ServerContinueButton" Style="{StaticResource PrimaryButton}"
                            Content="Continuer" Click="ServerContinue_Click"/>

                    <TextBlock x:Name="ServerStatusText" Style="{StaticResource CaptionText}"
                               Margin="0,14,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </ui:CardBorder>

            <!-- Vue 1 : connexion (affichée si pas d'identifiants mémorisés) -->
            <ui:CardBorder x:Name="LoginPanel" Style="{StaticResource Card}"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="26,24">
                <StackPanel>
                    <TextBlock Text="Connexion" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,3"/>
                    <DockPanel Margin="0,0,0,18">
                        <Button x:Name="ChangeServerButton" DockPanel.Dock="Right"
                                Style="{StaticResource SubtleButton}" Padding="6,0"
                                Content="Changer" VerticalAlignment="Center"
                                Click="ChangeServer_Click"/>
                        <TextBlock x:Name="LoginServerLabel" Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Utilisateur" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="UserBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Mot de passe" Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PassBox" Margin="0,0,0,12"
                                 KeyDown="PassBox_KeyDown"/>

                    <!-- Second facteur : masqué tant que le serveur ne l'a pas
                         réclamé. Une fois ce poste mémorisé, il ne réapparaît
                         qu'à l'expiration de l'autorisation. -->
                    <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed"
                                Margin="0,0,0,14">
                        <TextBlock Text="Code à deux facteurs"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TokenBox" Margin="0,0,0,10"
                                 KeyDown="PassBox_KeyDown"/>

                        <!-- Mémoriser le poste suppose de mémoriser la session :
                             la case suit donc « Rester connecté sur ce poste ». -->
                        <CheckBox x:Name="TrustDeviceCheck"
                                  Content="Ne plus demander de code sur ce poste"
                                  IsChecked="True" FontSize="12"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  IsEnabled="{Binding IsChecked, ElementName=RememberCheck}"/>
                        <TextBlock x:Name="TrustDeviceHint" Style="{StaticResource FieldHint}"
                                   Margin="24,4,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="SendCodeButton" Style="{StaticResource SubtleButton}"
                                Content="Recevoir un code par courriel"
                                Margin="0,10,0,0" Padding="12,6"
                                HorizontalAlignment="Left" Visibility="Collapsed"
                                Click="SendCode_Click"/>
                    </StackPanel>

                    <CheckBox x:Name="RememberCheck" Content="Rester connecté sur ce poste"
                              IsChecked="True" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,18"/>

                    <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}"
                            Content="Se connecter" Click="ConnectButton_Click"/>

                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}"
                               Margin="0,14,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </ui:CardBorder>

            <!-- Vue 2 : liste des appareils -->
            <DockPanel x:Name="DevicesPanel" Visibility="Collapsed">
                <!-- Barre de recherche + filtre + compteur -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- Champ de recherche : la loupe et le texte vivent DANS le
                             cadre, dont la hauteur est fixée pour s'aligner sur les
                             autres contrôles de la barre. -->
                        <Border Width="300" Height="34" CornerRadius="8"
                                Background="{StaticResource ControlBrush}"
                                BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource PlaceholderBrush}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <!-- Champ sans bordure : le cadre est porté par le Border -->
                                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                                             BorderThickness="0" Background="Transparent"
                                             Padding="0" FontSize="13"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="SearchPlaceholder"
                                               Text="Rechercher un appareil…" FontSize="13"
                                               Foreground="{StaticResource PlaceholderBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Effacer la recherche -->
                                <Button x:Name="ClearSearchButton" Grid.Column="2"
                                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="10" Width="22" Height="22"
                                        Margin="0,0,7,0" Padding="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Visibility="Collapsed" Click="ClearSearch_Click"
                                        ToolTip="Effacer"/>
                            </Grid>
                        </Border>

                        <!-- Filtre : n'afficher que les machines connectées -->
                        <CheckBox x:Name="OnlineOnlyCheck" Content="En ligne uniquement"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="OnlineOnly_Changed" Unchecked="OnlineOnly_Changed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"/>
                        <!-- Envoi groupé : choisir des fichiers et plusieurs machines -->
                        <Button x:Name="SendFilesButton" Style="{StaticResource AccentToolButton}"
                                Click="SendFiles_Click" Margin="12,0,0,0" Padding="10,5"
                                ToolTip="Envoyer des fichiers vers une ou plusieurs machines — ou glissez-les sur une machine de la liste">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Envoyer des fichiers" FontSize="11.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Ordre des machines dans chaque dossier -->
                        <Button x:Name="SortButton" Style="{StaticResource ToolButton}"
                                Click="SortButton_Click" Margin="12,0,0,0" Padding="9,5"
                                ToolTip="Trier les machines">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SortLabel" Text="Nom" FontSize="11.5"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SortMenu">
                                    <MenuItem Header="Nom" Tag="0" IsCheckable="True" Click="SortChoice_Click"/>
                                    <MenuItem Header="En ligne d'abord" Tag="1" IsCheckable="True" Click="SortChoice_Click"/>
                                    <MenuItem Header="Dernière présence" Tag="2" IsCheckable="True" Click="SortChoice_Click"/>
                                    <MenuItem Header="Système" Tag="3" IsCheckable="True" Click="SortChoice_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Bascule entre la liste groupée et la vue à deux volets -->
                        <Button x:Name="ToggleViewButton" Style="{StaticResource ToolButton}"
                                Click="ToggleView_Click" Margin="12,0,0,0"
                                Padding="8,5" ToolTip="Afficher les dossiers à gauche">
                            <TextBlock x:Name="ToggleViewGlyph" Text="&#xE8A4;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <!-- Replier / déplier tous les dossiers -->
                        <Button x:Name="ToggleGroupsButton" Style="{StaticResource ToolButton}"
                                Click="ToggleGroups_Click" Margin="12,0,0,0"
                                Padding="8,5" FontSize="11"
                                ToolTip="Replier tous les dossiers">
                            <TextBlock x:Name="ToggleGroupsGlyph" Text="&#xE70E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Vue à deux volets. La colonne de gauche est dimensionnée au
                     contenu : volet masqué, elle ne prend aucune place et la
                     liste occupe toute la largeur, comme dans la vue groupée. -->
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Volet des dossiers -->
                <ui:CardBorder x:Name="FolderPane" Grid.Column="0" Visibility="Collapsed"
                        Style="{StaticResource Card}" Padding="6" Width="238"
                        Margin="0,0,14,0">
                    <ListBox x:Name="FolderList"
                             Style="{StaticResource DeviceListBoxStyle}"
                             ItemContainerStyle="{StaticResource FolderItemStyle}"
                             SelectionChanged="FolderList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{Binding GlyphColor}"
                                               VerticalAlignment="Center" Margin="1,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <!-- Nombre de machines en ligne : c'est ce qu'on
                                         cherche en ouvrant un dossier. Le total est
                                         dans l'info-bulle. -->
                                    <TextBlock Grid.Column="2" Text="{Binding Counter}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Opacity="{Binding CounterOpacity}"
                                               VerticalAlignment="Center" Margin="8,0,1,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ui:CardBorder>

                <!-- Carte contenant la liste -->
                <ui:CardBorder Grid.Column="1" Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="DeviceList"
                             Style="{StaticResource DeviceListBoxStyle}"
                             ItemContainerStyle="{StaticResource DeviceItemStyle}"
                             MouseDoubleClick="DeviceList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="DeviceList_PreviewMouseRightButtonDown"
                             AllowDrop="True" DragOver="DeviceList_DragOver"
                             Drop="DeviceList_Drop">
                        <!-- Clic droit : actions sur la machine (le clic gauche/double
                             ouvre directement le bureau à distance). -->
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="DeviceMenu" Opened="DeviceMenu_Opened">
                                <MenuItem x:Name="MenuDesktop" Header="Bureau à distance"
                                          FontWeight="SemiBold" Click="MenuDesktop_Click"/>
                                <MenuItem x:Name="MenuTerminal" Header="Terminal"
                                          Click="MenuTerminal_Click"
                                          ToolTip="Invite de commandes / PowerShell via l'agent"/>
                                <MenuItem x:Name="MenuFiles" Header="Fichiers"
                                          Click="MenuFiles_Click"
                                          ToolTip="Parcourir et transférer des fichiers"/>
                                <MenuItem x:Name="MenuSendFiles" Header="Envoyer des fichiers…"
                                          Click="MenuSendFiles_Click"
                                          ToolTip="Vers cette machine et d'autres, en parallèle"/>
                                <MenuItem x:Name="MenuSsh" Header="Terminal SSH"
                                          Click="MenuSsh_Click"
                                          ToolTip="Nécessite SSH activé sur le serveur MeshCentral"/>
                                <Separator/>
                                <MenuItem x:Name="MenuWake" Header="Réveiller (Wake-on-LAN)"
                                          Click="MenuWake_Click"/>
                                <MenuItem x:Name="MenuReboot" Header="Redémarrer…"
                                          Click="MenuReboot_Click"/>
                                <MenuItem x:Name="MenuSleep" Header="Mettre en veille…"
                                          Click="MenuSleep_Click"/>
                                <MenuItem x:Name="MenuPowerOff" Header="Éteindre…"
                                          Click="MenuPowerOff_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MenuProcesses" Header="Processus…"
                                          Click="MenuProcesses_Click"
                                          ToolTip="Voir et arrêter les processus de la machine"/>
                                <MenuItem x:Name="MenuOpenUrl" Header="Ouvrir une URL…"
                                          Click="MenuOpenUrl_Click"
                                          ToolTip="Lancer le navigateur de la machine sur une adresse"/>
                                <Separator/>
                                <MenuItem x:Name="MenuFavorite" Header="Ajouter aux favoris"
                                          Click="MenuFavorite_Click"/>
                                <MenuItem x:Name="MenuShare" Header="Partager un lien…"
                                          Click="MenuShare_Click"
                                          ToolTip="Créer un lien public temporaire (et son code iframe)"/>
                                <MenuItem x:Name="MenuRename" Header="Renommer…"
                                          InputGestureText="F2"
                                          Click="MenuRename_Click"
                                          ToolTip="Changer le nom affiché dans MeshCentral"/>
                                <MenuItem x:Name="MenuCopyName" Header="Copier le nom"
                                          Click="MenuCopyName_Click"/>
                                <MenuItem x:Name="MenuInfo" Header="Informations système…"
                                          Click="MenuInfo_Click"
                                          ToolTip="Processeur, mémoire, disques, BIOS"/>
                                <MenuItem x:Name="MenuWebPage" Header="Ouvrir la page web…"
                                          InputGestureText="Ctrl+Maj+W"
                                          Click="MenuWebPage_Click"
                                          ToolTip="Voir cette machine dans MeshCentral"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <!-- Regroupement par dossier (groupe d'appareils MeshCentral) -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <!-- L'état est restauré et mémorisé par code :
                                                         la liste étant reconstruite à chaque
                                                         événement serveur, un IsExpanded figé
                                                         rouvrirait les groupes en permanence. -->
                                                    <!-- Expanded/Collapsed sont attachés par code
                                                         dans GroupExpander_Loaded : câblés ici, ils
                                                         s'accumuleraient au recyclage des
                                                         conteneurs par la virtualisation. -->
                                                    <Expander Style="{StaticResource GroupExpander}"
                                                              Margin="0,2,0,6"
                                                              Loaded="GroupExpander_Loaded">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <!-- Favoris et Récentes portent déjà
                                                                     leur symbole dans leur nom. -->
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="0,4,0,0"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pastille d'icône OS avec indicateur de statut -->
                                    <Grid Grid.Column="0"
                                          Width="{DynamicResource DeviceIconSize}"
                                          Height="{DynamicResource DeviceIconSize}"
                                          Margin="0,0,12,0">
                                        <Border Background="{Binding OsGlyphBackground}"
                                                CornerRadius="10"/>
                                        <TextBlock Text="{Binding OsGlyph}" FontSize="17"
                                                   Foreground="{Binding OsGlyphColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse Width="11" Height="11"
                                                 Fill="{Binding StatusBrush}"
                                                 Stroke="{StaticResource CardBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,-1,-1"/>
                                    </Grid>

                                    <!-- Nom + description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource DeviceNameSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Actions au survol, utilisateur connecté, badge
                                         de statut et étoile de favori -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Actions rapides : sans elles, tout ce qui n'est
                                             pas le bureau à distance passait par le clic droit.
                                             Masquées au repos pour ne pas charger la liste. -->
                                        <StackPanel x:Name="HoverActions" Orientation="Horizontal"
                                                    Visibility="Collapsed" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding RemoteActionsVisibility}">
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xE7F4;" Tag="{Binding}"
                                                        CommandParameter="Desktop" Click="RowAction_Click"
                                                        ToolTip="Bureau à distance"/>
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xE756;" Tag="{Binding}"
                                                        CommandParameter="Terminal" Click="RowAction_Click"
                                                        ToolTip="Terminal"/>
                                                <Button Style="{StaticResource RowActionButton}"
                                                        Content="&#xF12B;" Tag="{Binding}"
                                                        CommandParameter="Files" Click="RowAction_Click"
                                                        ToolTip="Fichiers"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource RowActionButton}"
                                                    Content="&#xE7E8;" Tag="{Binding}"
                                                    CommandParameter="Wake" Click="RowAction_Click"
                                                    Visibility="{Binding WakeActionVisibility}"
                                                    ToolTip="Réveiller (Wake-on-LAN)"/>
                                        </StackPanel>

                                        <!-- Utilisateur MeshCentral connecté à la machine :
                                             à savoir avant de prendre la main. -->
                                        <Border Background="{StaticResource ChipBrush}" CornerRadius="7"
                                                Padding="7,2,8,2"
                                                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                                Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding SessionVisibility}"
                                                ToolTip="{Binding SessionTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding SessionLabel}" FontSize="11"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Dernière présence : vide pour une machine
                                             en ligne, le badge le dit déjà. -->
                                        <TextBlock Text="{Binding LastSeenLabel}"
                                                   Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.75" FontSize="10"
                                                   ToolTip="Dernière connexion au serveur"/>
                                        <Border Background="{Binding BadgeBackground}"
                                                CornerRadius="7" Padding="8,3" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding BadgeForeground}"/>
                                        </Border>
                                        <Button Content="{Binding FavoriteGlyph}"
                                                Foreground="{Binding FavoriteColor}"
                                                FontSize="15" Width="26" Height="26"
                                                Padding="0" Margin="6,0,2,0" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Click="Favorite_Click"
                                                ToolTip="Épingler / retirer des favoris"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                          RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="HoverActions" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ui:CardBorder>
                </Grid>
            </DockPanel>

            <!-- Vue 3 : chargement -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Connexion au serveur…" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingDetail" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- ================= Bandeau de confirmation ================= -->
    <!-- Les confirmations d'action s'écrivaient auparavant dans le compteur
         d'appareils, que le prochain événement du serveur réécrivait dans la
         seconde : le message disparaissait avant d'avoir été lu. -->
    <Border x:Name="ToastBanner" Visibility="Collapsed" IsHitTestVisible="False"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,28" CornerRadius="9" Padding="16,11"
            Background="#F21C1C1E" Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="#44000000" BlurRadius="18" ShadowDepth="2"
                              Direction="270" Opacity="0.8"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="✓" FontSize="13" FontWeight="SemiBold"
                       Foreground="#34C759" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="White"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
        </StackPanel>
    </Border>

    <!-- ================= Voile ================= -->
    <!-- Assombrit le contenu et capte le clic pour fermer le volet. -->
    <Border x:Name="SettingsScrim" Background="#40000000" Visibility="Collapsed"
            Opacity="0" MouseLeftButtonDown="SettingsScrim_Click"/>

    <!-- ================= Volet des réglages ================= -->
    <Border x:Name="SettingsPanel" Width="420" HorizontalAlignment="Right"
            Background="{StaticResource WindowBackgroundBrush}"
            Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="24" ShadowDepth="0"
                              Direction="180" Opacity="0.9"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SettingsTransform" X="420"/>
        </Border.RenderTransform>

        <DockPanel>
            <!-- En-tête du volet -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                    Padding="20,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Réglages" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SettingsSubtitle" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ToolButton}" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,4" FontSize="12" Click="CloseSettings_Click"
                            ToolTip="Fermer (Échap)"/>
                </Grid>
            </Border>

            <!-- Pied : actions -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <TextBlock x:Name="SettingsFeedback" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Style="{StaticResource ToolButton}"
                                Padding="16,8" Margin="0,0,8,0" Click="CloseSettings_Click"/>
                        <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}"
                                Padding="18,8" Click="SaveSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenu défilant -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,18,20">
                <StackPanel>

                    <!-- Bureau à distance -->
                    <TextBlock Text="Bureau à distance" Style="{StaticResource PanelSectionTitle}"/>
                    <TextBlock Text="Valeurs appliquées à chaque nouvelle session."
                               Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="Qualité d'image" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultQualityCombo" FontSize="12"
                                      VerticalContentAlignment="Center" Margin="0,0,0,14">
                                <ComboBoxItem Content="Basse — réseau lent"/>
                                <ComboBoxItem Content="Équilibrée" IsSelected="True"/>
                                <ComboBoxItem Content="Haute — image nette"/>
                            </ComboBox>

                            <TextBlock Text="Fluidité" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DefaultFrameRateCombo" FontSize="12"
                                      VerticalContentAlignment="Center">
                                <!-- Mêmes valeurs que DesktopSession.FrameRates. -->
                                <ComboBoxItem Content="5 images/s" Tag="5"/>
                                <ComboBoxItem Content="10 images/s" Tag="10" IsSelected="True"/>
                                <ComboBoxItem Content="15 images/s" Tag="15"/>
                                <ComboBoxItem Content="20 images/s" Tag="20"/>
                                <ComboBoxItem Content="25 images/s" Tag="25"/>
                                <ComboBoxItem Content="30 images/s" Tag="30"/>
                                <ComboBoxItem Content="40 images/s" Tag="40"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Au-delà de 30 img/s, l'agent et le réseau deviennent souvent le facteur limitant."/>

                            <TextBlock Text="Échelle de l'image"
                                       Style="{StaticResource CaptionText}" Margin="0,14,0,5"/>
                            <ComboBox x:Name="DefaultScaleCombo">
                                <ComboBoxItem Content="100 % — taille réelle" Tag="100" IsSelected="True"/>
                                <ComboBoxItem Content="75 %" Tag="75"/>
                                <ComboBoxItem Content="50 %" Tag="50"/>
                                <ComboBoxItem Content="33 %" Tag="33"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="L'agent encode moins de pixels : c'est le réglage le plus efficace sur les liaisons lentes. Modifiable par session dans le menu « ⋯ »."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <CheckBox x:Name="DefaultFitCheck"
                                      Content="Ajuster l'écran à la fenêtre"/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <CheckBox x:Name="TabbedSessionsCheck"
                                      Content="Regrouper les sessions en onglets"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Décochez pour ouvrir chaque session dans sa propre fenêtre. S'applique aux nouvelles sessions."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <TextBlock Text="Densité de la liste"
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="DensityCombo"
                                      SelectionChanged="DensityCombo_SelectionChanged">
                                <ComboBoxItem Content="Compact"/>
                                <ComboBoxItem Content="Normal" IsSelected="True"/>
                                <ComboBoxItem Content="Confortable"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Le mode compact affiche davantage de machines à l'écran."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <CheckBox x:Name="DarkModeCheck" Content="Thème sombre"
                                      Checked="DarkMode_Changed" Unchecked="DarkMode_Changed"/>
                            <TextBlock x:Name="DarkModeHint" Style="{StaticResource FieldHint}"
                                       Margin="24,4,0,0"
                                       Text="Pour toutes les fenêtres de l'application. S'applique au prochain démarrage."/>
                            <Button x:Name="RestartForThemeButton" Style="{StaticResource SubtleButton}"
                                    Content="Redémarrer maintenant" HorizontalAlignment="Left"
                                    Margin="18,4,0,0" Visibility="Collapsed"
                                    Click="RestartForTheme_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Recherche rapide -->
                    <TextBlock Text="Recherche rapide" Style="{StaticResource PanelSectionTitle}"/>
                    <TextBlock Text="Ouvre une palette de recherche par-dessus vos autres applications."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <CheckBox x:Name="QuickSearchCheck"
                                      Content="Activer le raccourci global"
                                      Checked="QuickSearch_Changed" Unchecked="QuickSearch_Changed"
                                      Margin="0,0,0,14"/>
                            <TextBlock Text="Raccourci clavier" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HotkeyBox" IsReadOnly="True" Cursor="Hand"
                                     FontSize="12" TextAlignment="Center"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Cliquez puis pressez la combinaison voulue (avec Ctrl, Alt, Maj ou Win)."/>
                            <TextBlock x:Name="HotkeyWarning" Style="{StaticResource FieldHint}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Comportement -->
                    <TextBlock Text="Comportement" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <CheckBox x:Name="TrayCheck"
                                      Content="Garder l'application dans la zone de notification"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,14"
                                       Text="La croix réduit l'application au lieu de la quitter."/>

                            <CheckBox x:Name="AutoStartCheck" Content="Démarrer avec Windows"
                                      Margin="0,0,0,12"/>
                            <CheckBox x:Name="StartMinimizedCheck"
                                      Content="Démarrer réduit dans la zone de notification"/>
                            <TextBlock x:Name="StartupWarning" Style="{StaticResource FieldHint}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Serveur -->
                    <TextBlock Text="Serveur" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="HostBox" Margin="0,0,0,14"/>
                            <CheckBox x:Name="SelfSignedCheck"
                                      Content="Autoriser un certificat auto-signé"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Modifier l'adresse impose de se reconnecter."/>
                        </StackPanel>
                    </Border>

                    <!-- Compte -->
                    <TextBlock Text="Compte" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <TextBlock x:Name="AccountText" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <CheckBox x:Name="RememberSettingCheck"
                                      Content="Mémoriser les identifiants"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,0"
                                       Text="Le mot de passe est chiffré pour votre session Windows."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <!-- Second facteur : état de l'autorisation de ce poste -->
                            <TextBlock Text="Code à deux facteurs"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TrustStateText" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TrustDeviceButton"
                                        Content="Autoriser ce poste sans limite"
                                        Style="{StaticResource ToolButton}"
                                        Click="TrustDevice_Click" Padding="14,7"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ForgetDeviceButton" Content="Oublier ce poste"
                                        Style="{StaticResource ToolButton}"
                                        Click="ForgetDevice_Click" Padding="14,7"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="Un jeton de connexion propre à ce poste remplace le code à deux facteurs et n'expire pas. Il se révoque ici, ou depuis « Mon compte » sur le serveur."/>

                            <Border Height="1" Background="{StaticResource SeparatorBrush}"
                                    Margin="0,14,0,14"/>

                            <Button x:Name="LogoutButton" Content="Se déconnecter"
                                    Style="{StaticResource ToolButton}"
                                    Click="Logout_Click" Padding="14,7"
                                    HorizontalAlignment="Left"
                                    Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Ferme la session et efface le mot de passe mémorisé."/>
                        </StackPanel>
                    </Border>

                    <!-- Mises à jour -->
                    <TextBlock Text="Mises à jour" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <CheckBox x:Name="CheckUpdatesCheck"
                                      Content="Rechercher les mises à jour au démarrage"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,14"
                                       Text="L'installation ferme puis relance l'application."/>
                            <Button Content="Rechercher maintenant"
                                    Style="{StaticResource ToolButton}" Click="CheckUpdates_Click"
                                    Padding="12,7" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic -->
                    <TextBlock Text="Diagnostic" Style="{StaticResource PanelSectionTitle}"/>
                    <Border Style="{StaticResource PanelSection}" Margin="0,8,0,14">
                        <StackPanel>
                            <CheckBox x:Name="VerboseLogCheck" Content="Journal détaillé"/>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="24,4,0,14"
                                       Text="Enregistre aussi les échanges de protocole. Plus volumineux."/>
                            <Button Content="Ouvrir le dossier des journaux"
                                    Style="{StaticResource ToolButton}" Click="OpenLogs_Click"
                                    Padding="12,7" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

    </Grid>
</ui:ChromeWindow>
