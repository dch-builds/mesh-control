<ui:ChromeWindow x:Class="MeshControl.UI.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sessions — Mesh Control" Height="740" Width="1180"
        MinWidth="900" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#1B1D21">

    <ui:ChromeWindow.Resources>
        <!-- Flèche de défilement du bandeau d'onglets. Cliquable dans la barre
             de titre (IsHitTestVisibleInChrome), non focalisable : le clavier
             reste à la session affichée. -->
        <Style x:Key="TabScrollButton" TargetType="RepeatButton">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Delay" Value="300"/>
            <Setter Property="Interval" Value="60"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:ChromeWindow.Resources>

    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"
                Padding="0" SelectionChanged="Tabs_SelectionChanged">

        <!-- Onglets compacts, avec bouton de fermeture. Ils vivent dans la barre
             de titre (fond CardBrush) : l'onglet actif s'en détache par un fond
             teinté d'accent, un trait d'accent et un texte plein ; les autres
             restent transparents, texte atténué. Couleurs de la palette, pour
             suivre le thème clair comme le sombre. -->
        <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <!-- IsHitTestVisibleInChrome : une fois le bandeau dans
                                 la barre de titre, le système capterait sinon les
                                 clics de l'onglet comme un glisser de fenêtre.

                                 Posé sur la racine du gabarit, SURTOUT PAS sur
                                 l'onglet : la propriété se transmet par l'arbre
                                 logique, et le contenu de l'onglet — la session
                                 entière — est enfant logique de l'onglet. Il en
                                 héritait, et Windows ne voyait plus aucun bord
                                 de redimensionnement à gauche, à droite ni en bas.
                                 Pas non plus sur le TabPanel : le parent logique
                                 d'un onglet est le TabControl, la valeur
                                 n'atteindrait pas les onglets. -->
                            <Grid Margin="2,0,0,0"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border x:Name="Bd" CornerRadius="7"
                                        Background="Transparent" Padding="11,6,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Le pictogramme est porté par le Tag de l'onglet :
                                             plus simple qu'une propriété attachée à lier. -->
                                        <TextBlock Text="{Binding Tag,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="12" Margin="0,0,7,0"
                                                   VerticalAlignment="Center"/>
                                        <!-- Titre tronqué : un nom de machine à rallonge
                                             occupait sinon la moitié du bandeau. Le nom
                                             complet reste dans l'info-bulle. -->
                                        <TextBlock Text="{Binding Header,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="CloseBtn" Content="✕" FontSize="9"
                                                Width="20" Height="20" Margin="8,0,0,0"
                                                Cursor="Hand" Focusable="False"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Click="CloseTab_Click"
                                                ToolTip="Fermer cet onglet (Ctrl+F4, ou clic du milieu)">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CloseBd" CornerRadius="5"
                                                            Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CloseBd" Property="Background"
                                                                    Value="{StaticResource ControlHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- Trait d'accent sous l'onglet actif. -->
                                <Border x:Name="Indicator" Height="2" CornerRadius="1"
                                        VerticalAlignment="Bottom" Margin="10,0,10,0"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentSoftBrush}"/>
                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter TargetName="CloseBtn" Property="Foreground"
                                            Value="{StaticResource TextPrimaryBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource RowHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </TabControl.ItemContainerStyle>

        <!-- Bandeau d'onglets sur fond sombre, contenu en dessous -->
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <!-- Masqué tant qu'une seule session est ouverte : un onglet
                         unique n'apporte rien et grignote de la hauteur. Dès
                         deux sessions, il quitte ce gabarit pour la barre de
                         titre de la fenêtre (voir SessionsWindow.UpdateTitleBar).
                         Les onglets y restent cliquables grâce au style des
                         onglets ; l'espace libre à leur droite sert de poignée. -->
                    <Border x:Name="TabStrip" DockPanel.Dock="Top" Background="#141619">
                        <!-- Une seule rangée qui défile (molette, flèches) : le
                             TabPanel d'origine passait à la ligne, et la barre de
                             titre coupait la seconde rangée. Les flèches ne
                             paraissent que si les onglets débordent. -->
                        <DockPanel Margin="6,0,6,0">
                            <RepeatButton x:Name="ScrollTabsLeft" DockPanel.Dock="Left"
                                          Content="&#xE76B;" Style="{StaticResource TabScrollButton}"
                                          Click="ScrollTabsLeft_Click" Visibility="Collapsed"
                                          ToolTip="Onglets précédents (ou molette sur les onglets)"/>
                            <RepeatButton x:Name="ScrollTabsRight" DockPanel.Dock="Right"
                                          Content="&#xE76C;" Style="{StaticResource TabScrollButton}"
                                          Click="ScrollTabsRight_Click" Visibility="Collapsed"
                                          ToolTip="Onglets suivants (ou molette sur les onglets)"/>
                            <ScrollViewer x:Name="TabScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False" Focusable="False">
                                <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Background="#1B1D21">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>
    </TabControl>
</ui:ChromeWindow>
