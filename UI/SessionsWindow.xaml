<ui:ChromeWindow x:Class="MeshControl.UI.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Sessions — Mesh Control" Height="740" Width="1180"
        MinWidth="900" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#1B1D21">

    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"
                Padding="0" SelectionChanged="Tabs_SelectionChanged">

        <!-- Onglets compacts, avec bouton de fermeture -->
        <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" CornerRadius="8,8,0,0"
                                    Background="#2A2D33" Margin="2,3,0,0"
                                    Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Le pictogramme est porté par le Tag de l'onglet :
                                         plus simple qu'une propriété attachée à lier. -->
                                    <TextBlock Text="{Binding Tag,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="12" Margin="0,0,7,0"
                                               VerticalAlignment="Center"/>
                                    <ContentPresenter ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                    <Button Content="✕" FontSize="9" Width="18" Height="18"
                                            Margin="9,0,0,0" Padding="0" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#9A9DA5"
                                            Click="CloseTab_Click"
                                            ToolTip="Fermer cet onglet (Ctrl+F4, ou clic du milieu)"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1B1D21"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#33363D"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="#E4E6EA"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </TabControl.ItemContainerStyle>

        <!-- Bandeau d'onglets sur fond sombre, contenu en dessous -->
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <!-- Masqué tant qu'une seule session est ouverte : un onglet
                         unique n'apporte rien et grignote de la hauteur. -->
                    <Border x:Name="TabStrip" DockPanel.Dock="Top" Background="#141619">
                        <TabPanel IsItemsHost="True" Margin="6,0,6,0"/>
                    </Border>
                    <Border Background="#1B1D21">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>
    </TabControl>
</ui:ChromeWindow>
