<Window x:Class="MeshControl.UI.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informations système — Mesh Control" Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel>

        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionText}"
                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Actualiser"
                        Style="{StaticResource ToolButton}" Click="Refresh_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Pied -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copier" Style="{StaticResource ToolButton}"
                            Click="Copy_Click" Padding="16,8" Margin="0,0,8,0"
                            ToolTip="Copier toutes les informations"/>
                    <Button Content="Fermer" Style="{StaticResource ToolButton}"
                            Click="Close_Click" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
            <StackPanel x:Name="SectionsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
