<ui:ChromeWindow x:Class="MeshControl.UI.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="PromptText" FontSize="13"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="ValueBox" KeyDown="ValueBox_KeyDown"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource ToolButton}"
                    Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton" Content="Valider"
                    Style="{StaticResource PrimaryButton}"
                    Click="Confirm_Click" Padding="18,8" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</ui:ChromeWindow>
