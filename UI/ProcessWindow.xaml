<ui:ChromeWindow x:Class="MeshControl.UI.ProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Processus — Mesh Control" Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="18">

        <!-- En-tête -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="KillButton" Content="Arrêter le processus"
                        Style="{StaticResource ToolButton}" Click="Kill_Click"
                        Padding="12,7" Margin="0,0,8,0" IsEnabled="False"
                        Foreground="{StaticResource DangerBrush}"/>
                <Button x:Name="RefreshButton" Content="Actualiser"
                        Style="{StaticResource ToolButton}" Click="Refresh_Click"
                        Padding="12,7"/>
            </StackPanel>
        </Grid>

        <!-- Recherche -->
        <Border DockPanel.Dock="Top" Width="300" HorizontalAlignment="Left" Height="34"
                CornerRadius="8" Background="White" Margin="0,0,0,12"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
            <Grid>
                <TextBox x:Name="FilterBox" BorderThickness="0" Background="Transparent"
                         Padding="11,0" FontSize="13" VerticalContentAlignment="Center"
                         TextChanged="FilterBox_TextChanged"/>
                <TextBlock x:Name="FilterPlaceholder" Text="Filtrer par nom…" FontSize="13"
                           Foreground="#AEAEB2" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Message d'état -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="2,10,0,0"/>

        <!-- Liste des processus -->
        <Border Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="ProcessList" BorderThickness="0" Background="Transparent"
                      SelectionChanged="ProcessList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="PID" Width="80"
                                        DisplayMemberBinding="{Binding Pid}"/>
                        <GridViewColumn Header="Nom" Width="330"
                                        DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Utilisateur" Width="200"
                                        DisplayMemberBinding="{Binding User}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</ui:ChromeWindow>
