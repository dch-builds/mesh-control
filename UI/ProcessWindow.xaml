<ui:ChromeWindow x:Class="MeshControl.UI.ProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Processus — Mesh Control" Height="680" Width="940"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20,16,20,16">

        <!-- En-tête : machine, compteur, actions -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="NodeDot" Width="8" Height="8" Margin="1,2,9,0"
                             VerticalAlignment="Center" Fill="{StaticResource OnlineBrush}"/>
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}" Margin="18,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Actualisation automatique, toutes les 5 secondes -->
                <ToggleButton x:Name="AutoRefreshToggle" Style="{StaticResource FilterChip}"
                              Margin="0,0,8,0" Click="AutoRefresh_Click"
                              ToolTip="Relire la liste toutes les 5 secondes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="Auto" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}"
                        Click="Refresh_Click" Padding="10,6" Margin="0,0,8,0"
                        ToolTip="Relire la liste (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="KillButton" Style="{StaticResource DangerToolButton}"
                        Click="Kill_Click" Padding="12,6" IsEnabled="False"
                        ToolTip="Arrêter les processus sélectionnés (Suppr)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,1,7,0"/>
                        <TextBlock x:Name="KillLabel" Text="Arrêter" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Recherche et pastilles -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MaxWidth="460"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Height="36" CornerRadius="10" Background="{StaticResource ControlBrush}"
                    BorderThickness="1" Margin="0,0,12,0" Cursor="IBeam"
                    MouseLeftButtonDown="SearchFrame_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource PlaceholderBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Grid Grid.Column="1" Margin="9,0,0,0">
                        <TextBox x:Name="FilterBox" BorderThickness="0" Background="Transparent"
                                 Padding="0" FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="FilterBox_TextChanged"
                                 PreviewKeyDown="FilterBox_PreviewKeyDown"/>
                        <TextBlock x:Name="FilterPlaceholder"
                                   Text="Rechercher un processus, un PID ou un utilisateur"
                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="ClearFilterButton" Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" Margin="0,0,5,0" Visibility="Collapsed"
                            Click="ClearFilter_Click" ToolTip="Effacer (Échap)"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ChipAll" Style="{StaticResource FilterChip}" Tag="all"
                              Click="Chip_Click" IsChecked="True" ToolTip="Tous les processus">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tous"/>
                        <TextBlock x:Name="ChipAllCount" Opacity="0.7" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipUser" Style="{StaticResource FilterChip}" Tag="user"
                              Click="Chip_Click"
                              ToolTip="Processus lancés par des utilisateurs : ceux qu'on arrête d'ordinaire">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Utilisateurs"/>
                        <TextBlock x:Name="ChipUserCount" Opacity="0.7" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipSystem" Style="{StaticResource FilterChip}" Tag="system"
                              Click="Chip_Click"
                              ToolTip="Processus du système et des services : à arrêter avec prudence">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Système"/>
                        <TextBlock x:Name="ChipSystemCount" Opacity="0.7" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Compte rendu des actions : arrêt confirmé, refusé, erreur -->
        <Border x:Name="StatusBanner" DockPanel.Dock="Bottom" Visibility="Collapsed"
                CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                Background="{StaticResource SubtleFillBrush}">
            <DockPanel>
                <TextBlock x:Name="StatusGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,10,0"/>
                <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Liste -->
        <ui:CardBorder Style="{StaticResource Card}" Padding="6">
            <DockPanel>
                <!-- En-têtes : un clic trie la colonne, un second inverse l'ordre -->
                <Border x:Name="ColumnHeader" DockPanel.Dock="Top"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                        Margin="0,2,0,4" Padding="10,4,10,7">
                    <Grid TextElement.FontSize="11.5"
                          TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Tag="name"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="Header_Click">
                            <TextBlock Text="Nom"/>
                            <TextBlock x:Name="ArrowName" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Margin="6,1,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Tag="pid"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="Header_Click">
                            <TextBlock Text="PID"/>
                            <TextBlock x:Name="ArrowPid" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Margin="6,1,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Tag="user"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="Header_Click">
                            <TextBlock Text="Utilisateur"/>
                            <TextBlock x:Name="ArrowUser" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Margin="6,1,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="ProcessList"
                             Style="{StaticResource DeviceListBoxStyle}"
                             ItemContainerStyle="{StaticResource DeviceItemStyle}"
                             SelectionMode="Extended"
                             SelectionChanged="ProcessList_SelectionChanged"
                             PreviewKeyDown="ProcessList_PreviewKeyDown"
                             PreviewMouseRightButtonDown="ProcessList_PreviewMouseRightButtonDown">
                        <ListBox.Resources>
                            <Thickness x:Key="DeviceRowPadding">10,3,10,3</Thickness>
                        </ListBox.Resources>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="RowMenu">
                                <MenuItem x:Name="MenuKill" Header="Arrêter" InputGestureText="Suppr"
                                          Foreground="{StaticResource DangerBrush}" Click="Kill_Click"/>
                                <Separator/>
                                <MenuItem Header="Copier le nom" Click="CopyName_Click"/>
                                <MenuItem Header="Copier le PID" Click="CopyPid_Click"/>
                                <MenuItem Header="Rechercher ce nom" Click="FilterSameName_Click"
                                          ToolTip="Afficher toutes les instances de ce programme"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="96"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="{Binding GlyphColor}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NameText" Grid.Column="1"
                                               ui:Highlight.Text="{Binding Name}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" ui:Highlight.Text="{Binding PidText}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" ui:Highlight.Text="{Binding UserLabel}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <!-- Arrêt en un clic, au survol ; état pendant l'arrêt -->
                                    <Button x:Name="RowKill" Grid.Column="4" Style="{StaticResource DangerToolButton}"
                                            Padding="9,3" FontSize="11" HorizontalAlignment="Right"
                                            Visibility="Collapsed" Tag="{Binding}" Click="RowKill_Click"
                                            Focusable="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                                            <TextBlock Text="Arrêter" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="StoppingText" Grid.Column="4" Text="Arrêt…"
                                               FontSize="11.5" FontStyle="Italic" HorizontalAlignment="Right"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                               Visibility="Collapsed" Margin="0,0,6,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                          RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="RowKill" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
                                        <Setter TargetName="NameText" Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStopping}" Value="True">
                                        <Setter TargetName="RowKill" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="StoppingText" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Chargement et liste vide -->
                    <StackPanel x:Name="LoadingState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ProgressBar x:Name="LoadingBar" Style="{StaticResource SlimProgressBar}" Width="180"/>
                        <TextBlock Text="Lecture des processus…" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{StaticResource PlaceholderBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Aucun processus ne correspond" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </ui:CardBorder>
    </DockPanel>
</ui:ChromeWindow>
