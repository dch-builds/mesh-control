<ui:ChromeWindow x:Class="MeshControl.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Mise à jour — Mesh Control"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>

        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <!-- Notes de version : hauteur bornée, la release peut être longue -->
        <ui:CardBorder x:Name="NotesBox" Style="{StaticResource Card}" Padding="12"
                Margin="0,0,0,14" Visibility="Collapsed">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </ui:CardBorder>

        <!-- Progression du téléchargement -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
            <TextBlock x:Name="ProgressLabel" Style="{StaticResource CaptionText}"
                       Margin="0,0,0,6"/>
            <ProgressBar x:Name="ProgressBarControl" Height="5" Minimum="0" Maximum="1"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource SubtleFillBrush}" BorderThickness="0"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed"/>

        <!-- Avertissement : l'application va se fermer -->
        <TextBlock x:Name="WarningText" Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="L'installation fermera l'application, puis la relancera automatiquement. Vos sessions ouvertes seront interrompues."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LaterButton" Content="Plus tard"
                    Style="{StaticResource ToolButton}"
                    Click="Later_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button x:Name="InstallButton" Content="Installer maintenant"
                    Style="{StaticResource PrimaryButton}"
                    Click="Install_Click" Padding="18,8" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</ui:ChromeWindow>
