<ui:ChromeWindow x:Class="MeshControl.UI.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Partager l'accès" Width="620" MaxHeight="740"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">

        <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Génère un lien public temporaire. Toute personne disposant du lien accède à la machine, sans compte MeshCentral."
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <!-- Paramètres du partage -->
        <TextBlock Text="NOUVEAU PARTAGE" Style="{StaticResource SectionHeaderText}"/>
        <ui:CardBorder Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Nom de l'invité" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="GuestBox" Text="Intégration Mesh Control"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Validité" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="DurationCombo" Width="150" FontSize="12"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="1 heure" Tag="60"/>
                            <ComboBoxItem Content="8 heures" Tag="480" IsSelected="True"/>
                            <ComboBoxItem Content="24 heures" Tag="1440"/>
                            <ComboBoxItem Content="7 jours" Tag="10080"/>
                            <ComboBoxItem Content="30 jours" Tag="43200"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Accès accordés" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="DesktopCheck" Content="Bureau à distance" IsChecked="True"
                              FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,16,0"
                              Checked="AccessOption_Changed" Unchecked="AccessOption_Changed"/>
                    <CheckBox x:Name="TerminalCheck" Content="Terminal" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                              Checked="AccessOption_Changed" Unchecked="AccessOption_Changed"/>
                    <CheckBox x:Name="FilesCheck" Content="Fichiers" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Checked="AccessOption_Changed" Unchecked="AccessOption_Changed"/>
                </StackPanel>

                <TextBlock Text="Consentement de l'utilisateur de la machine"
                           Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="ConsentCombo" FontSize="12"
                          VerticalContentAlignment="Center" Margin="0,0,0,14">
                    <ComboBoxItem Content="Demander l'autorisation (recommandé)" Tag="prompt"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="Notifier seulement" Tag="notify"/>
                    <ComboBoxItem Content="Aucune notification" Tag="none"/>
                </ComboBox>

                <CheckBox x:Name="ViewOnlyCheck" Content="Lecture seule (le destinataire ne peut pas agir)"
                          FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                          Margin="0,0,0,14"
                          ToolTip="Se définit à la création : ce réglage ne peut plus être modifié ensuite"/>

                <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,0,0,12"/>

                <TextBlock Text="Intégration" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,6"/>
                <CheckBox x:Name="HideUiCheck" Content="Réduire l'interface (hide=15)"
                          IsChecked="True" FontSize="12"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"
                          ToolTip="Argument reconnu par MeshCentral, mais son effet reste limité : il n'ajuste que des hauteurs de zone"/>
                <CheckBox x:Name="FullScreenIframeCheck" Content="Iframe plein écran (100 %)"
                          IsChecked="True" FontSize="12"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"
                          Checked="DisplayOption_Changed" Unchecked="DisplayOption_Changed"/>

                <!-- Le seul levier réellement efficace sur l'interface -->
                <Border x:Name="SingleAccessHint" Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                        Padding="11,9" Margin="0,0,0,14">
                    <TextBlock x:Name="SingleAccessText" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}"/>
                </Border>

                <Button x:Name="CreateButton" Content="Créer le lien"
                        Style="{StaticResource PrimaryButton}" Padding="18,9"
                        HorizontalAlignment="Left" Click="Create_Click"/>

                <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ui:CardBorder>

        <!-- Résultat -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
            <TextBlock Text="LIEN GÉNÉRÉ" Style="{StaticResource SectionHeaderText}"/>
            <ui:CardBorder Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Lien direct" Style="{StaticResource CaptionText}"
                               Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LinkBox" Grid.Column="0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                 Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1">
                            <Button Content="Copier" Style="{StaticResource ToolButton}"
                                    Click="CopyLink_Click" Padding="12,5" Margin="0,0,0,4"/>
                            <Button Content="Ouvrir" Style="{StaticResource ToolButton}"
                                    Click="OpenLink_Click" Padding="12,5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Code d'intégration (iframe)" Style="{StaticResource CaptionText}"
                               Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IframeBox" Grid.Column="0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                 Height="72" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Copier"
                                Style="{StaticResource ToolButton}"
                                Click="CopyIframe_Click" Padding="12,5"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="11,9" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningTextBrush}"
                                   Text="L'iframe ne s'affichera que si votre serveur MeshCentral l'autorise : ajoutez &quot;allowFraming&quot;: true et &quot;allowedFramingOrigins&quot; dans son config.json. Sans cela, le navigateur bloque l'affichage (protection anti-clickjacking) — le lien direct fonctionne dans tous les cas."/>
                    </Border>
                </StackPanel>
            </ui:CardBorder>
        </StackPanel>

        <!-- Partages existants -->
        <TextBlock Text="PARTAGES ACTIFS" Style="{StaticResource SectionHeaderText}"/>
        <ui:CardBorder Style="{StaticResource Card}" Padding="6" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="NoSharesText" Text="Aucun partage actif."
                           Style="{StaticResource CaptionText}" Margin="10,8"/>
                <ItemsControl x:Name="SharesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding GuestName}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Style="{StaticResource CaptionText}">
                                        <Run Text="{Binding FeaturesText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ExpiryText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copier" Style="{StaticResource ToolButton}"
                                            Padding="9,3" FontSize="11" Margin="0,0,5,0"
                                            Tag="{Binding Url}" Click="CopyExisting_Click"/>
                                    <Button Content="Révoquer" Style="{StaticResource ToolButton}"
                                            Padding="9,3" FontSize="11"
                                            Foreground="{StaticResource DangerBrush}"
                                            Tag="{Binding PublicId}" Click="Revoke_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardBorder>

        <Button Content="Fermer" Style="{StaticResource ToolButton}"
                HorizontalAlignment="Right" Padding="18,8" Click="Close_Click"/>
    </StackPanel>
    </ScrollViewer>
</ui:ChromeWindow>
