<Window x:Class="MeshControl.UI.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recherche rapide" Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">

    <!-- Palette flottante : coins arrondis, ombre portée -->
    <Border Background="White" CornerRadius="14" Margin="18">
        <Border.Effect>
            <DropShadowEffect Color="#55000000" BlurRadius="28" ShadowDepth="4"
                              Direction="270" Opacity="0.7"/>
        </Border.Effect>

        <StackPanel>
            <!-- Champ de saisie -->
            <Grid Margin="18,16,18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="17" VerticalAlignment="Center"
                               Margin="0,0,12,0" Opacity="0.45"/>
                    <TextBox x:Name="QueryBox" Width="530" FontSize="18"
                             BorderThickness="0" Background="Transparent"
                             Padding="0,4" VerticalContentAlignment="Center"
                             TextChanged="QueryBox_TextChanged"
                             PreviewKeyDown="QueryBox_PreviewKeyDown"/>
                </StackPanel>
                <TextBlock x:Name="Placeholder" Text="Nom d'une machine…"
                           FontSize="18" Foreground="#B0B0B8"
                           Margin="41,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <Border Height="1" Background="{StaticResource SeparatorBrush}"/>

            <!-- Résultats -->
            <ListBox x:Name="ResultList" MaxHeight="330" BorderThickness="0"
                     Background="Transparent" Margin="6,6,6,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="9" Padding="12,9">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F7"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource AccentSoftBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,12,0">
                                <Border Background="#F0F0F5" CornerRadius="8"/>
                                <TextBlock Text="{Binding OsGlyph}" FontSize="15"
                                           Foreground="{Binding OsGlyphColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"
                                         Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,-1,-1"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Un seul TextBlock : Run.Text impose une liaison
                                     TwoWay, incompatible avec une propriété en
                                     lecture seule comme GroupName. -->
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="{Binding GroupLabel}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding BadgeForeground}"
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Aide en pied -->
            <Border Background="#FAFAFC" CornerRadius="0,0,14,14" Padding="16,8">
                <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}"
                           Text="↑↓ naviguer · Entrée se connecter · Échap fermer"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
