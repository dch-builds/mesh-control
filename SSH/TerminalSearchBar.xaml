<UserControl x:Class="MeshControl.Ssh.TerminalSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,12,16,0">
    <!-- Posée par-dessus le terminal plutôt qu'insérée au-dessus : l'insérer
         changerait la hauteur de la grille, donc la taille annoncée au shell
         distant, à chaque ouverture et fermeture de la recherche. -->
    <UserControl.Resources>
        <!-- Boutons sombres, assortis au terminal. Focusable="False" : le champ
             de saisie doit garder le clavier d'un bout à l'autre. -->
        <Style x:Key="SearchButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="#3C3C44"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#2A2A30" CornerRadius="8" Padding="8,6"
            BorderBrush="#3C3C44" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#50000000" BlurRadius="12" ShadowDepth="2"
                              Direction="270" Opacity="0.8"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="QueryBox" Width="190" FontSize="12"
                     Background="#1B1B1F" Foreground="#E4E6EA"
                     CaretBrush="#E4E6EA" BorderBrush="#3C3C44" BorderThickness="1"
                     Padding="6,3" VerticalContentAlignment="Center"
                     TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"/>

            <!-- Rang de l'occurrence courante sur le total, ou « Aucun résultat » -->
            <TextBlock x:Name="CountText" FontSize="11" Foreground="#9A9AA2"
                       VerticalAlignment="Center" MinWidth="76"
                       TextAlignment="Center" Margin="8,0,4,0"/>

            <Button x:Name="PreviousButton" Content="▲" Style="{StaticResource SearchButton}"
                    Click="Previous_Click" ToolTip="Occurrence précédente (Maj+Entrée)"/>
            <Button x:Name="NextButton" Content="▼" Style="{StaticResource SearchButton}"
                    Click="Next_Click" ToolTip="Occurrence suivante (Entrée)"/>
            <Button Content="✕" Style="{StaticResource SearchButton}"
                    Click="Close_Click" Margin="4,0,0,0"
                    ToolTip="Fermer la recherche (Échap)"/>
        </StackPanel>
    </Border>
</UserControl>
