<Window x:Class="MeshControl.Ssh.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal — Mesh Control" Height="620" Width="920"
        WindowStartupLocation="CenterScreen" Background="#1B1B1F">
    <DockPanel>
        <!-- Barre d'outils -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border x:Name="StatusBadge" CornerRadius="8" Padding="8,2"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="StatusLabel" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="Shell" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="ShellCombo" Width="180" FontSize="12"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ShellCombo_SelectionChanged"/>

                    <!-- Compte réellement utilisé par le shell (résultat de whoami) -->
                    <Border x:Name="IdentityBadge" Background="#EFEFF4" CornerRadius="6"
                            Padding="7,3" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="IdentityText" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Coller" Style="{StaticResource ToolButton}"
                            Click="Paste_Click" Margin="0,0,6,0"
                            ToolTip="Coller le presse-papiers (Ctrl+Maj+V)"/>
                    <Button Content="Copier tout" Style="{StaticResource ToolButton}"
                            Click="CopyAll_Click" Margin="0,0,6,0"
                            ToolTip="Copier le contenu du terminal (Ctrl+Maj+C)"/>
                    <Button Content="Reconnecter" Style="{StaticResource ToolButton}"
                            Click="Reconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal (contrôle dessiné à la main, ajouté par code) -->
        <Border x:Name="TerminalHost" Background="#1B1B1F"/>
    </DockPanel>
</Window>
