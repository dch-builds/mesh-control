<ui:ChromeWindow x:Class="MeshControl.Ssh.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        xmlns:ssh="clr-namespace:MeshControl.Ssh"
        Title="Terminal — Mesh Control" Height="620" Width="920"
        WindowStartupLocation="CenterScreen" Background="#1B1B1F">
    <DockPanel x:Name="RootPanel">
        <!-- Barre d'outils -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <!-- Deux colonnes : le titre absorbe la réduction de largeur (il est
                 tronqué), les contrôles gardent leur taille. Sans colonnes, les
                 deux blocs se superposent dès que la fenêtre rétrécit. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Border x:Name="StatusBadge" CornerRadius="8" Padding="8,2"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="StatusLabel" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Text="Shell" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="ShellCombo" Width="180" FontSize="12"
                              VerticalContentAlignment="Center"
                              SelectionChanged="ShellCombo_SelectionChanged"/>

                    <!-- Compte réellement utilisé par le shell (résultat de whoami) -->
                    <Border x:Name="IdentityBadge" Background="{StaticResource SubtleFillBrush}" CornerRadius="6"
                            Padding="7,3" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="IdentityText" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Focusable="False" : un bouton qui garde le focus après le
                     clic détourne la frappe suivante. Entrée le réactivait au
                     lieu de valider la commande — « Coller » collait deux fois. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Commandes courantes de maintenance, adaptées au shell
                         ouvert (voir QuickCommands). -->
                    <Button x:Name="CommandsButton" Style="{StaticResource ToolButton}"
                            Click="Commands_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Commandes courantes : dossiers, informations, réseau, maintenance (Ctrl+Maj+K)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Commandes ▾" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="Paste_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Coller le presse-papiers (Ctrl+Maj+V, ou clic du milieu)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Coller" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="CopyAll_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Copier la sélection, ou tout le terminal à défaut (Ctrl+Maj+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Copier" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="Search_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Rechercher dans l'historique (Ctrl+Maj+R)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Rechercher" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReconnectButton" Style="{StaticResource ToolButton}"
                            Click="Reconnect_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Rouvrir la session (Entrée, une fois la session fermée)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Reconnecter" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FullscreenButton" Content="⛶"
                            Style="{StaticResource ToolButton}"
                            Click="Fullscreen_Click" Padding="9,5" Focusable="False"
                            ToolTip="Plein écran (Ctrl+Maj+F)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal (contrôle dessiné à la main, ajouté par code) -->
        <Grid>
            <!-- Marge : le texte ne colle plus aux bords. Pas à droite, où
                 se tient la glissière de l'historique. -->
            <Border x:Name="TerminalHost" Background="#1B1B1F" Padding="10,8,0,0"/>

            <ssh:TerminalSearchBar x:Name="SearchBar"/>

            <!-- En plein écran, la barre d'outils disparaît : sans ce rappel,
                 le moyen d'en sortir serait invisible. Échap n'est pas utilisé,
                 la touche devant rester disponible pour le shell. -->
            <Border x:Name="FullscreenHint" Visibility="Collapsed"
                    IsHitTestVisible="False" Background="#D9000000"
                    CornerRadius="8" Padding="14,8"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,18,0,0">
                <TextBlock Text="Plein écran — Ctrl+Maj+F pour revenir"
                           Foreground="#E4E6EA" FontSize="12"/>
            </Border>
        </Grid>
    </DockPanel>
</ui:ChromeWindow>
