<ui:ChromeWindow x:Class="MeshControl.Ssh.CustomCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        Title="Mes commandes — Mesh Control" Width="780" Height="500"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <DockPanel Margin="20,16,20,18">
        <!-- Valider / annuler -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,220,0"
                       Text="Enregistrées dans vos réglages, sur ce poste. Les commandes vides sont ignorées."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource ToolButton}"
                        Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" Padding="18,8"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste, dans l'ordre du menu -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource ToolButton}" Click="Add_Click"
                            Margin="0,0,6,0" ToolTip="Nouvelle commande">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Nouvelle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}"
                            Click="Delete_Click" Padding="9,6" Margin="0,0,6,0"
                            Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Supprimer la commande"/>
                    <Button x:Name="UpButton" Style="{StaticResource ToolButton}"
                            Click="Up_Click" Padding="9,6" Margin="0,0,6,0"
                            Content="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Monter dans le menu"/>
                    <Button x:Name="DownButton" Style="{StaticResource ToolButton}"
                            Click="Down_Click" Padding="9,6"
                            Content="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                            ToolTip="Descendre dans le menu"/>
                </StackPanel>

                <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="4">
                    <Grid>
                        <ListBox x:Name="CommandList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource DeviceItemStyle}"
                                 SelectionChanged="CommandList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0">
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ShellLabel}"
                                                   Style="{StaticResource CaptionText}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="16"
                                   Text="Aucune commande. « Nouvelle » pour en ajouter une."/>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Édition de la commande sélectionnée -->
            <DockPanel x:Name="Editor" Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Libellé" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="LabelBox"
                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Shell" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
                    <ComboBox x:Name="ShellCombo" Width="260" HorizontalAlignment="Left" FontSize="12"
                              SelectedIndex="{Binding ShellIndex}">
                        <ComboBoxItem Content="Tous les shells"/>
                        <ComboBoxItem Content="Windows — invite de commandes (cmd)"/>
                        <ComboBoxItem Content="Windows — PowerShell"/>
                        <ComboBoxItem Content="Linux / macOS"/>
                    </ComboBox>

                    <TextBlock Text="Commande" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <CheckBox x:Name="RunCheck" IsChecked="{Binding Run}"
                              Content="Exécuter directement (sinon la commande est seulement tapée, à valider par Entrée)"/>
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="24,4,0,0"
                               Text="Laissez décoché pour tout ce qui modifie la machine. Une commande sur plusieurs lignes envoie chaque ligne avec Entrée, sauf la dernière si elle n'est que tapée."/>
                </StackPanel>

                <TextBox x:Name="CommandBox" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="13"
                         Text="{Binding CommandValue, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</ui:ChromeWindow>
