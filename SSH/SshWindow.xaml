<ui:ChromeWindow x:Class="MeshControl.Ssh.SshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MeshControl.UI"
        xmlns:ssh="clr-namespace:MeshControl.Ssh"
        xmlns:desk="clr-namespace:MeshControl.Desktop"
        Title="Terminal SSH — Mesh Control" Height="620" Width="920"
        WindowStartupLocation="CenterScreen" Background="#1B1B1F">
    <DockPanel x:Name="RootPanel">
        <!-- Barre d'outils -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="12,7">
            <!-- Deux colonnes : le titre absorbe la réduction de largeur (il est
                 tronqué), les contrôles gardent leur taille. Sans colonnes, les
                 deux blocs se superposent dès que la fenêtre rétrécit. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Border x:Name="StatusBadge" CornerRadius="8" Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLabel" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Focusable="False" : un bouton qui garde le focus après le
                     clic détourne la frappe suivante. Entrée le réactivait au
                     lieu de valider la commande — « Coller » collait deux fois.
                     Les champs du bandeau d'authentification, eux, gardent le
                     focus : on y saisit vraiment quelque chose. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Bureau à distance de la même machine : en vignette ancrée en
                         bas à droite du terminal, pour garder l'écran sous les yeux en
                         tapant, ou en grand dans un onglet (voir DesktopDock). -->
                    <Button x:Name="DesktopButton" Style="{StaticResource ToolButton}"
                            Click="Desktop_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Bureau à distance : en vignette dans le terminal, ou dans un onglet (Ctrl+Maj+D)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Bureau ▾" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="Paste_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Coller le presse-papiers dans le terminal (Ctrl+Maj+V, ou clic du milieu)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Coller" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="CopyAll_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Copier la sélection, ou tout le terminal à défaut (Ctrl+Maj+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Copier" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="Search_Click" Margin="0,0,6,0" Focusable="False"
                            ToolTip="Rechercher dans l'historique (Ctrl+Maj+R)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Rechercher" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}"
                            Click="Clear_Click" Margin="0,0,6,0" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="Effacer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FullscreenButton" Content="⛶"
                            Style="{StaticResource ToolButton}"
                            Click="Fullscreen_Click" Padding="9,5" Focusable="False"
                            ToolTip="Plein écran (Ctrl+Maj+F)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bandeau d'authentification -->
        <Border x:Name="AuthPanel" DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="16,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="AuthTitle" Text="Identifiants SSH" FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="UsernameGroup" Margin="0,0,12,0">
                        <TextBlock Text="Utilisateur" Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="UserBox" Width="180"
                                 KeyDown="AuthField_KeyDown"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="PasswordLabel" Text="Mot de passe"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PassBox" Width="200"
                                     KeyDown="AuthField_KeyDown"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,12,0">
                        <CheckBox x:Name="RememberCheck" FontSize="12"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Content="Mémoriser sur le serveur"
                                  ToolTip="Enregistre les identifiants côté MeshCentral pour les prochaines sessions"
                                  Margin="0,0,0,7"/>
                    </StackPanel>

                    <Button Content="Se connecter" Style="{StaticResource PrimaryButton}"
                            Click="Authenticate_Click" VerticalAlignment="Bottom"
                            Padding="16,7" Margin="0,0,0,1"/>
                </StackPanel>

                <TextBlock x:Name="AuthError" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Terminal (ajouté par code : contrôle dessiné à la main) -->
        <Grid>
            <!-- Marge : le texte ne colle plus aux bords. Pas à droite, où
                 se tient la glissière de l'historique. -->
            <Border x:Name="TerminalHost" Background="#1B1B1F" Padding="10,8,0,0"/>

            <ssh:TerminalSearchBar x:Name="SearchBar"/>

            <!-- Bureau à distance ancré (Ctrl+Maj+D), au-dessus du terminal. -->
            <desk:DesktopDock x:Name="DockedDesktop"/>

            <!-- En plein écran, la barre d'outils disparaît : sans ce rappel,
                 le moyen d'en sortir serait invisible. Échap n'est pas utilisé,
                 la touche devant rester disponible pour le shell. -->
            <Border x:Name="FullscreenHint" Visibility="Collapsed"
                    IsHitTestVisible="False" Background="#D9000000"
                    CornerRadius="8" Padding="14,8"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,18,0,0">
                <TextBlock Text="Plein écran — Ctrl+Maj+F pour revenir"
                           Foreground="#E4E6EA" FontSize="12"/>
            </Border>
        </Grid>
    </DockPanel>
</ui:ChromeWindow>
