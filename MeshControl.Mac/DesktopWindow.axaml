<local:ChromeWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:MeshControl.Mac"
                   x:Class="MeshControl.Mac.DesktopWindow"
                   Width="1280" Height="820" MinWidth="640" MinHeight="400"
                   WindowStartupLocation="CenterScreen">

  <!-- Portage de Desktop/DesktopWindow.xaml (version Windows), en fenêtre
       autonome : la barre d'outils se loge dans la barre de titre, une seule
       bande au lieu de deux (MergeToolbarIntoTitleBar). -->
  <local:ChromeWindow.Styles>
    <!-- Pastille posée sur l'image distante (zoom, vue seule) : cliquable,
         elle rappelle un état et permet d'en sortir. -->
    <Style Selector="Button.overlayChip">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#E4E6EA" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Chip" Background="#D9000000" CornerRadius="8" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
              <local:Icon Kind="Close" Size="10" Foreground="#E4E6EA" VerticalAlignment="Center" Margin="10,1,0,0" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.overlayChip:pointerover /template/ Border#Chip">
      <Setter Property="Background" Value="#F2000000" />
    </Style>
  </local:ChromeWindow.Styles>

  <DockPanel x:Name="RootPanel" Background="{DynamicResource WindowBackgroundBrush}">
    <local:TitleBar x:Name="WindowTitleBar" DockPanel.Dock="Top">
      <local:TitleBar.Content>
        <Grid x:Name="Toolbar" ColumnDefinitions="*,Auto">
          <!-- Identité de la machine -->
          <!-- Le titre absorbe la réduction de largeur (tronqué), les contrôles
               gardent leur taille. -->
          <DockPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="0,0,12,0" LastChildFill="True">
            <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="9" Height="9"
                     Fill="{DynamicResource OnlineBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock x:Name="ResolutionText" DockPanel.Dock="Right" Classes="caption"
                       VerticalAlignment="Center" Margin="10,1,0,0" />
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>

          <!-- Contrôles : ils ne prennent pas le focus, le clavier reste à l'écran distant. -->
          <StackPanel x:Name="ToolbarControls" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <ComboBox x:Name="QualityCombo" Width="104" Focusable="False" ToolTip.Tip="Qualité d'image"
                      SelectionChanged="QualityCombo_SelectionChanged">
              <ComboBoxItem Content="Dépannage" Tag="3"
                            ToolTip.Tip="Liaison très lente : compression maximale, image réduite, 5 img/s au plus" />
              <ComboBoxItem Content="Basse" Tag="0" />
              <ComboBoxItem Content="Équilibrée" Tag="1" />
              <ComboBoxItem Content="Haute" Tag="2" />
              <ComboBoxItem Content="Fluide" Tag="4"
                            ToolTip.Tip="Pour suivre une vidéo : 40 img/s et bonne qualité d'image. Demande une bonne connexion" />
            </ComboBox>

            <ComboBox x:Name="FrameRateCombo" Width="104" Focusable="False" Margin="8,0,0,0"
                      ToolTip.Tip="Fluidité : taux de rafraîchissement de l'écran distant"
                      SelectionChanged="FrameRateCombo_SelectionChanged">
              <ComboBoxItem Content="5 img/s" Tag="5" />
              <ComboBoxItem Content="10 img/s" Tag="10" />
              <ComboBoxItem Content="15 img/s" Tag="15" />
              <ComboBoxItem Content="20 img/s" Tag="20" />
              <ComboBoxItem Content="25 img/s" Tag="25" />
              <ComboBoxItem Content="30 img/s" Tag="30" />
              <ComboBoxItem Content="40 img/s" Tag="40" />
            </ComboBox>

            <!-- Sélecteur d'écran : masqué tant que la machine n'en a qu'un. -->
            <Button x:Name="DisplayButton" Classes="tool" IsVisible="False" Focusable="False"
                    Padding="9,5" Margin="12,0,0,0" ToolTip.Tip="Choisir l'écran affiché (Ctrl+Maj+← / →)">
              <StackPanel Orientation="Horizontal">
                <local:Icon Kind="Desktop" Size="13" VerticalAlignment="Center" />
                <TextBlock x:Name="DisplayButtonText" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" />
              </Button.Flyout>
            </Button>

            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="14,2,14,2" />

            <CheckBox x:Name="FitCheck" Content="Ajuster" Focusable="False" VerticalAlignment="Center"
                      IsChecked="True" IsCheckedChanged="Fit_Changed" Margin="0,0,12,0"
                      ToolTip.Tip="Ajuster l'image à la fenêtre (Ctrl+Maj+A)" />

            <Button x:Name="ReconnectButton" Content="Reconnecter" Classes="tool" Focusable="False"
                    Click="Reconnect_Click" Margin="0,0,6,0" IsVisible="False"
                    ToolTip.Tip="Relancer la connexion à cette machine" />

            <Button x:Name="RefreshButton" Content="Rafraîchir" Classes="tool" Focusable="False"
                    Click="Refresh_Click" Margin="0,0,6,0"
                    ToolTip.Tip="Redemander une image complète (Ctrl+Maj+R)" />

            <Button x:Name="ShortcutsButton" Content="Raccourcis ▾" Classes="tool" Focusable="False"
                    Margin="0,0,6,0"
                    ToolTip.Tip="Combinaisons envoyées à la machine distante (Ctrl+Alt+Suppr : Ctrl+Maj+Suppr)">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" />
              </Button.Flyout>
            </Button>

            <!-- Les deux façons de coller, réunies en un bloc segmenté. -->
            <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PasteButton" Content="Coller" Classes="tool" Focusable="False"
                        Background="Transparent" Click="Paste_Click"
                        ToolTip.Tip="Coller le presse-papiers local sur la machine distante (Ctrl+Maj+V)" />
                <Border Width="1" Margin="0,6" Background="{DynamicResource SeparatorBrush}" />
                <Button x:Name="PasteTypingButton" Classes="tool" Focusable="False" Background="Transparent"
                        Click="PasteAsTyping_Click"
                        ToolTip.Tip="Coller en simulant la frappe : lent, mais fonctionne partout, même là où Ctrl+V est ignoré">
                  <StackPanel Orientation="Horizontal">
                    <local:Icon x:Name="PasteTypingGlyph" Kind="Keyboard" Size="12" VerticalAlignment="Center"
                                Margin="0,1,6,0" />
                    <TextBlock x:Name="PasteTypingLabel" Text="Taper" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Border Width="1" Margin="0,6" Background="{DynamicResource SeparatorBrush}" />
                <!-- Interrupteur : synchronisation automatique du presse-papiers
                     dans les deux sens. Mis en évidence (bleu) quand il est actif. -->
                <Button x:Name="ClipboardSyncButton" Classes="tool" Focusable="False" Background="Transparent"
                        Click="ClipboardSync_Click" Padding="9,5">
                  <local:Icon Kind="Sync" Size="13" />
                </Button>
              </StackPanel>
            </Border>

            <Button x:Name="CopyFromRemoteButton" Content="Copier depuis" Classes="tool" Focusable="False"
                    Click="CopyFromRemote_Click" Margin="0,0,6,0"
                    ToolTip.Tip="Récupérer le presse-papiers de la machine distante (Ctrl+Maj+C)" />

            <Button x:Name="ScreenshotButton" Classes="tool" Focusable="False"
                    Click="Screenshot_Click" Padding="9,5" Margin="0,0,6,0"
                    ToolTip.Tip="Capturer l'écran distant (Ctrl+Maj+S)">
              <local:Icon Kind="Camera" Size="13" />
            </Button>

            <!-- Loupe : on trace un rectangle sur l'écran pour l'agrandir.
                 Un second clic revient à la vue entière. -->
            <Button x:Name="ZoomButton" Classes="tool" Focusable="False" Click="Zoom_Click" Padding="9,5"
                    Margin="0,0,6,0" ToolTip.Tip="Agrandir une zone : tracer un rectangle sur l'écran (Ctrl+Maj+Z)">
              <local:Icon x:Name="ZoomButtonGlyph" Kind="ZoomIn" Size="13" />
            </Button>

            <!-- Vue seule : la souris et le clavier ne partent plus vers la machine. -->
            <Button x:Name="ViewOnlyButton" Classes="tool" Focusable="False" Click="ViewOnly_Click" Padding="9,5"
                    Margin="0,0,6,0" ToolTip.Tip="Vue seule : observer sans envoyer souris ni clavier (Ctrl+Maj+O)">
              <local:Icon Kind="View" Size="13" />
            </Button>

            <Button x:Name="ReleaseModifiersButton" Classes="tool" Focusable="False"
                    Click="ReleaseModifiers_Click" Padding="9,5" Margin="0,0,6,0"
                    ToolTip.Tip="Débloquer le clavier distant : relâche Ctrl, Alt, Maj, Win (Ctrl+Maj+D)">
              <local:Icon Kind="Keyboard" Size="13" />
            </Button>

            <Button x:Name="FullscreenButton" Classes="tool" Focusable="False"
                    Click="Fullscreen_Click" Padding="9,5" Margin="0,0,6,0"
                    ToolTip.Tip="Plein écran (Ctrl+Maj+F)">
              <local:Icon Kind="FullScreen" Size="13" />
            </Button>

            <Button x:Name="PowerButton" Classes="tool" Focusable="False" Padding="9,5" Margin="0,0,6,0"
                    ToolTip.Tip="Redémarrer, mettre en veille ou éteindre la machine (redémarrage : Ctrl+Maj+B)">
              <local:Icon Kind="Power" Size="13" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Redémarrer…" Click="Reboot_Click" />
                  <MenuItem Header="Mettre en veille…" Click="Sleep_Click" />
                  <MenuItem Header="Éteindre…" Click="PowerOff_Click" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button x:Name="MoreButton" Content="⋯" Classes="tool" Focusable="False" Padding="9,5"
                    ToolTip.Tip="Autres outils : terminal (Ctrl+Maj+T), fichiers (Ctrl+Maj+E), processus (Ctrl+Maj+P), page web (Ctrl+Maj+W), échelle de l'image">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <!-- Boutons de la barre repliés ici quand la fenêtre est trop
                       étroite pour les afficher (voir FitToolbar). -->
                  <MenuItem x:Name="OverflowCopyItem" IsVisible="False" Header="Copier depuis la machine"
                            Click="CopyFromRemote_Click" />
                  <MenuItem x:Name="OverflowScreenshotItem" IsVisible="False" Header="Capturer l'écran"
                            Click="Screenshot_Click" />
                  <MenuItem x:Name="OverflowZoomItem" IsVisible="False" Header="Loupe" Click="Zoom_Click" />
                  <MenuItem x:Name="OverflowReleaseItem" IsVisible="False" Header="Débloquer le clavier distant"
                            Click="ReleaseModifiers_Click" />
                  <Separator x:Name="OverflowSeparator" IsVisible="False" />
                  <MenuItem Header="Terminal" Click="OpenTerminal_Click" />
                  <MenuItem Header="Fichiers" Click="OpenFiles_Click" />
                  <MenuItem Header="Processus…" Click="OpenProcesses_Click" />
                  <Separator />
                  <MenuItem Header="Page web MeshCentral" Click="OpenWebPage_Click" />
                  <MenuItem Header="Informations système…" Click="OpenSystemInfo_Click" />
                  <Separator />
                  <MenuItem x:Name="ScaleMenu" Header="Échelle de l'image">
                    <MenuItem Header="100 % — taille réelle" Tag="100" ToggleType="CheckBox" Click="Scale_Click" />
                    <MenuItem Header="75 %" Tag="75" ToggleType="CheckBox" Click="Scale_Click" />
                    <MenuItem Header="50 % — deux fois moins de données" Tag="50" ToggleType="CheckBox" Click="Scale_Click" />
                    <MenuItem Header="33 % — liaison lente" Tag="33" ToggleType="CheckBox" Click="Scale_Click" />
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <TextBlock x:Name="StatsText" Classes="caption" VerticalAlignment="Center" Margin="14,0,4,0"
                       MinWidth="70" TextAlignment="Right" />
          </StackPanel>
        </Grid>
      </local:TitleBar.Content>
    </local:TitleBar>

    <!-- Barre d'état persistante : latence, débit, résolution. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock x:Name="StatusLatency" Classes="caption" VerticalAlignment="Center" MinWidth="86"
                     ToolTip.Tip="Latence aller-retour avec la machine" />
          <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="10,1,10,1" />
          <TextBlock x:Name="StatusThroughput" Classes="caption" VerticalAlignment="Center" MinWidth="92"
                     ToolTip.Tip="Débit reçu du flux d'image" />
          <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="10,1,10,1" />
          <TextBlock x:Name="StatusResolution" Classes="caption" VerticalAlignment="Center"
                     ToolTip.Tip="Résolution de l'écran distant" />

          <!-- Envoi de fichiers déposés sur l'écran : visible le temps du transfert. -->
          <StackPanel x:Name="TransferPanel" Orientation="Horizontal" IsVisible="False">
            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="10,1,10,1" />
            <TextBlock x:Name="StatusTransfer" Classes="caption" Foreground="{DynamicResource InfoTextBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            <Button Content="Annuler" Classes="tool" Focusable="False" Click="CancelDrop_Click" Padding="7,1"
                    FontSize="11" Margin="8,0,0,0" ToolTip.Tip="Interrompre l'envoi des fichiers déposés" />
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusTotal" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource PlaceholderBrush}" ToolTip.Tip="Volume total reçu depuis le début de la session" />
      </Grid>
    </Border>

    <!-- Zone d'affichage : fond sombre, l'écran distant en valeur. Deux
         conteneurs exclusifs : ajusté à la fenêtre, ou taille réelle défilante. -->
    <Panel x:Name="ScreenHost" Background="#1B1D21" Focusable="True">
      <Panel x:Name="FitHost" ClipToBounds="True">
        <!-- Origine en haut à gauche : la loupe compose sa propre matrice. -->
        <Image x:Name="ScreenImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" RenderTransformOrigin="0,0" />
      </Panel>
      <ScrollViewer x:Name="Scroller" IsVisible="False" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto" Focusable="False">
        <Image x:Name="ScreenImageNative" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </ScrollViewer>
      <!-- Rappel à l'entrée en plein écran : sans lui, le moyen d'en sortir
           serait invisible. Échap reste à la machine distante. -->
      <Border x:Name="FullscreenHint" IsVisible="False" IsHitTestVisible="False" Background="#D9000000"
              CornerRadius="8" Padding="14,8" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,18,0,0">
        <TextBlock Text="Plein écran — souris en haut de l'écran pour la barre d'outils, Ctrl+Maj+F pour revenir"
                   Foreground="#E4E6EA" FontSize="12" />
      </Border>

      <!-- Barre flottante du plein écran : apparaît quand la souris touche le
           bord haut de l'écran, disparaît quand elle s'en éloigne. -->
      <Border x:Name="FullscreenBar" IsVisible="False" Opacity="0" VerticalAlignment="Top"
              HorizontalAlignment="Center" Background="#EB1B1D21" BorderBrush="#33FFFFFF"
              BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="8,5"
              BoxShadow="0 2 16 0 #80000000">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          </Transitions>
        </Border.Transitions>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="FullscreenBarDot" Width="8" Height="8" Fill="{DynamicResource OnlineBrush}"
                   VerticalAlignment="Center" Margin="6,0,8,0" />
          <TextBlock x:Name="FullscreenBarTitle" Foreground="#E4E6EA" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"
                     Margin="0,0,10,0" />
          <Border Width="1" Background="#33FFFFFF" Margin="2,5" />

          <Button x:Name="BarPasteButton" Classes="overlay" Click="Paste_Click" Margin="4,0,0,0"
                  ToolTip.Tip="Coller le presse-papiers local (Ctrl+Maj+V)">
            <StackPanel Orientation="Horizontal">
              <local:Icon Kind="Paste" Size="13" VerticalAlignment="Center" Margin="0,1,6,0" />
              <TextBlock Text="Coller" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="BarTypingButton" Classes="overlay" Click="PasteAsTyping_Click"
                  ToolTip.Tip="Coller en simulant la frappe">
            <StackPanel Orientation="Horizontal">
              <local:Icon x:Name="BarTypingGlyph" Kind="Keyboard" Size="13" VerticalAlignment="Center" Margin="0,1,6,0" />
              <TextBlock x:Name="BarTypingLabel" Text="Taper" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="BarSyncButton" Classes="overlay" Click="ClipboardSync_Click" Padding="9,6">
            <local:Icon Kind="Sync" Size="13" />
          </Button>

          <Border Width="1" Background="#33FFFFFF" Margin="4,5" />

          <Button x:Name="BarShortcutsButton" Classes="overlay" Content="Raccourcis ▾"
                  ToolTip.Tip="Combinaisons envoyées à la machine distante">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" />
            </Button.Flyout>
          </Button>
          <Button x:Name="BarCtrlAltDelButton" Classes="overlay" Content="Ctrl+Alt+Suppr" Click="CtrlAltDel_Click"
                  ToolTip.Tip="Envoyer Ctrl+Alt+Suppr (Ctrl+Maj+Suppr)" />
          <Button x:Name="BarViewOnlyButton" Classes="overlay" Click="ViewOnly_Click" Padding="9,6"
                  ToolTip.Tip="Vue seule (Ctrl+Maj+O)">
            <local:Icon Kind="View" Size="13" />
          </Button>
          <Button Classes="overlay" Click="Screenshot_Click" Padding="9,6"
                  ToolTip.Tip="Capturer l'écran distant (Ctrl+Maj+S)">
            <local:Icon Kind="Camera" Size="13" />
          </Button>

          <Border Width="1" Background="#33FFFFFF" Margin="4,5" />

          <Button Classes="overlay" Click="Fullscreen_Click" ToolTip.Tip="Quitter le plein écran (Ctrl+Maj+F)">
            <StackPanel Orientation="Horizontal">
              <local:Icon Kind="BackToWindow" Size="13" VerticalAlignment="Center" Margin="0,1,6,0" />
              <TextBlock Text="Quitter" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Tracé de la zone à agrandir. Fond transparent mais présent : c'est
           lui qui reçoit la souris, qui ne part donc pas vers la machine. -->
      <Canvas x:Name="ZoomOverlay" IsVisible="False" Background="Transparent" Cursor="Cross">
        <Rectangle x:Name="ZoomBand" IsVisible="False" Stroke="{DynamicResource AccentBrush}"
                   StrokeThickness="1.5" Fill="#260A84FF" />
      </Canvas>

      <Border x:Name="ZoomHint" IsVisible="False" IsHitTestVisible="False" Background="#D9000000"
              CornerRadius="8" Padding="14,8" VerticalAlignment="Top" HorizontalAlignment="Center"
              Margin="0,18,0,0">
        <TextBlock Text="Tracez la zone à agrandir — Échap ou clic droit pour annuler"
                   Foreground="#E4E6EA" FontSize="12" />
      </Border>

      <!-- Rappel du zoom en cours, cliquable pour revenir à la vue entière. -->
      <Button x:Name="ZoomBadge" Classes="overlayChip" IsVisible="False" Click="ZoomBadge_Click"
              VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,14,14,0"
              ToolTip.Tip="Revenir à la vue entière (Ctrl+Maj+Z)" />

      <!-- Liaison lente repérée : propose le mode dépannage, sans l'imposer. -->
      <Border x:Name="SlowLinkBanner" IsVisible="False" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="10"
              Padding="14,8,8,8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18"
              BoxShadow="0 2 18 0 #59000000">
        <StackPanel Orientation="Horizontal">
          <local:Icon Kind="Warning" Size="13" Foreground="{DynamicResource TextSecondaryBrush}"
                      VerticalAlignment="Center" Margin="0,1,10,0" />
          <TextBlock Text="Connexion lente : l'image arrive en retard." Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" TextTrimming="CharacterEllipsis" />
          <Button Content="Passer en mode dépannage" Classes="accentTool" Focusable="False"
                  Click="SlowLinkSwitch_Click" Margin="0,0,6,0" />
          <Button Content="Ignorer" Classes="tool" Focusable="False" Click="SlowLinkDismiss_Click" />
        </StackPanel>
      </Border>

      <!-- Rappel permanent de la vue seule : sans lui, on croirait la session
           figée. Cliquable pour reprendre la main. -->
      <Button x:Name="ViewOnlyBadge" Classes="overlayChip" IsVisible="False" Click="ViewOnly_Click"
              VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14,14,0,0"
              ToolTip.Tip="Reprendre le contrôle (Ctrl+Maj+O)">
        <StackPanel Orientation="Horizontal">
          <local:Icon Kind="View" Size="12" Foreground="#E4E6EA" VerticalAlignment="Center" Margin="0,1,8,0" />
          <TextBlock Text="Vue seule" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Fichiers glissés au-dessus de l'écran : rappelle où ils iront. -->
      <Panel x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False" Background="#B3101215">
        <Rectangle Margin="18" RadiusX="12" RadiusY="12" Stroke="{DynamicResource AccentBrush}"
                   StrokeThickness="2" StrokeDashArray="6,4" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <local:Icon Kind="Upload" Size="34" Foreground="#E4E6EA" HorizontalAlignment="Center" />
          <TextBlock Text="Déposer pour envoyer à la machine" FontSize="16" FontWeight="SemiBold"
                     Foreground="#E4E6EA" HorizontalAlignment="Center" Margin="0,12,0,4" />
          <TextBlock x:Name="DropDestinationText" FontSize="12" Foreground="#A0A4AB" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>

      <TextBlock x:Name="OverlayText" Foreground="#C8FFFFFF" FontSize="15" HorizontalAlignment="Center"
                 VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                 IsHitTestVisible="False" />
    </Panel>
  </DockPanel>
</local:ChromeWindow>
