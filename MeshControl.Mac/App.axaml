<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MeshControl.Mac.App"
             Name="Mesh Control">
  <!-- Fluent pour les contrôles laissés tels quels, puis le thème de
       l'application (Theme/Theme.axaml), repris de la version Windows. La
       palette est posée par le code au démarrage (Theme/Palette.cs). -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MeshControl.Mac/Theme/Theme.axaml" />
  </Application.Styles>
</Application>
