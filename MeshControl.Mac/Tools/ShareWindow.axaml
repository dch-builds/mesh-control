<local:ChromeWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:MeshControl.Mac"
                   xmlns:core="using:MeshControl.Core"
                   x:Class="MeshControl.Mac.ShareWindow"
                   Width="620" MaxHeight="780" SizeToContent="Height" CanResize="False"
                   WindowStartupLocation="CenterOwner">

  <!-- Portage de UI/ShareWindow.xaml (version Windows). -->
  <DockPanel>
    <local:TitleBar x:Name="WindowTitleBar" DockPanel.Dock="Top" Title="Partager l'accès" ShowMinMax="False" />

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22">

        <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBlock Text="Génère un lien public temporaire. Toute personne disposant du lien accède à la machine, sans compte MeshCentral."
                   Classes="caption" TextWrapping="Wrap" Margin="0,0,0,18" />

        <!-- Paramètres du partage -->
        <TextBlock Text="NOUVEAU PARTAGE" Classes="section" />
        <Border Classes="card" Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Nom de l'invité" Classes="caption" Margin="0,0,0,4" />
                <TextBox x:Name="GuestBox" Text="Intégration Mesh Control" FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Validité" Classes="caption" Margin="0,0,0,4" />
                <ComboBox x:Name="DurationCombo" Width="150" FontSize="12" SelectedIndex="1">
                  <ComboBoxItem Content="1 heure" Tag="60" />
                  <ComboBoxItem Content="8 heures" Tag="480" />
                  <ComboBoxItem Content="24 heures" Tag="1440" />
                  <ComboBoxItem Content="7 jours" Tag="10080" />
                  <ComboBoxItem Content="30 jours" Tag="43200" />
                </ComboBox>
              </StackPanel>
            </Grid>

            <TextBlock Text="Accès accordés" Classes="caption" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <CheckBox x:Name="DesktopCheck" Content="Bureau à distance" IsChecked="True" FontSize="12"
                        Margin="0,0,16,0" IsCheckedChanged="AccessOption_Changed" />
              <CheckBox x:Name="TerminalCheck" Content="Terminal" FontSize="12" Margin="0,0,16,0"
                        IsCheckedChanged="AccessOption_Changed" />
              <CheckBox x:Name="FilesCheck" Content="Fichiers" FontSize="12"
                        IsCheckedChanged="AccessOption_Changed" />
            </StackPanel>

            <TextBlock Text="Consentement de l'utilisateur de la machine" Classes="caption" Margin="0,0,0,4" />
            <ComboBox x:Name="ConsentCombo" FontSize="12" HorizontalAlignment="Stretch" Margin="0,0,0,14"
                      SelectedIndex="0">
              <ComboBoxItem Content="Demander l'autorisation (recommandé)" Tag="prompt" />
              <ComboBoxItem Content="Notifier seulement" Tag="notify" />
              <ComboBoxItem Content="Aucune notification" Tag="none" />
            </ComboBox>

            <CheckBox x:Name="ViewOnlyCheck" Content="Lecture seule (le destinataire ne peut pas agir)"
                      FontSize="12" Margin="0,0,0,14"
                      ToolTip.Tip="Se définit à la création : ce réglage ne peut plus être modifié ensuite" />

            <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,12" />

            <TextBlock Text="Intégration" Classes="caption" Margin="0,0,0,6" />
            <CheckBox x:Name="HideUiCheck" Content="Réduire l'interface (hide=15)" IsChecked="True" FontSize="12"
                      Margin="0,0,0,6" IsCheckedChanged="DisplayOption_Changed"
                      ToolTip.Tip="Argument reconnu par MeshCentral, mais son effet reste limité : il n'ajuste que des hauteurs de zone" />
            <CheckBox x:Name="FullScreenIframeCheck" Content="Iframe plein écran (100 %)" IsChecked="True"
                      FontSize="12" Margin="0,0,0,10" IsCheckedChanged="DisplayOption_Changed" />

            <!-- Le seul levier réellement efficace sur l'interface -->
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="11,9" Margin="0,0,0,14">
              <TextBlock x:Name="SingleAccessText" Classes="caption" TextWrapping="Wrap"
                         Foreground="{DynamicResource InfoTextBrush}" />
            </Border>

            <Button x:Name="CreateButton" Content="Créer le lien" Classes="primary" Padding="18,9"
                    HorizontalAlignment="Left" Click="Create_Click" />

            <TextBlock x:Name="ErrorText" Classes="caption" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False" />
          </StackPanel>
        </Border>

        <!-- Résultat -->
        <StackPanel x:Name="ResultPanel" IsVisible="False">
          <TextBlock Text="LIEN GÉNÉRÉ" Classes="section" />
          <Border Classes="card" Padding="16" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Lien direct" Classes="caption" Margin="0,0,0,4" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox x:Name="LinkBox" IsReadOnly="True" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0"
                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
                <StackPanel Grid.Column="1">
                  <Button Content="Copier" Classes="tool" Click="CopyLink_Click" Padding="12,5" Margin="0,0,0,4" />
                  <Button Content="Ouvrir" Classes="tool" Click="OpenLink_Click" Padding="12,5" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Code d'intégration (iframe)" Classes="caption" Margin="0,0,0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="IframeBox" IsReadOnly="True" FontSize="11" TextWrapping="Wrap" Height="72"
                         AcceptsReturn="True" Margin="0,0,8,0"
                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
                <Button Grid.Column="1" Content="Copier" Classes="tool" Click="CopyIframe_Click" Padding="12,5"
                        VerticalAlignment="Top" />
              </Grid>

              <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="11,9" Margin="0,12,0,0">
                <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}"
                           Text="L'iframe ne s'affichera que si votre serveur MeshCentral l'autorise : ajoutez &quot;allowFraming&quot;: true et &quot;allowedFramingOrigins&quot; dans son config.json. Sans cela, le navigateur bloque l'affichage (protection anti-clickjacking) — le lien direct fonctionne dans tous les cas." />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Partages existants -->
        <TextBlock Text="PARTAGES ACTIFS" Classes="section" />
        <Border Classes="card" Padding="6" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock x:Name="NoSharesText" Text="Aucun partage actif." Classes="caption" Margin="10,8" />
            <ItemsControl x:Name="SharesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="core:DeviceShare">
                  <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="{Binding GuestName}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Classes="caption">
                        <Run Text="{Binding FeaturesText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding ExpiryText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Copier" Classes="tool" Padding="9,3" FontSize="11" Margin="0,0,5,0"
                              Click="CopyExisting_Click" />
                      <Button Content="Révoquer" Classes="tool" Padding="9,3" FontSize="11"
                              Foreground="{DynamicResource DangerBrush}" Click="Revoke_Click" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Button Content="Fermer" Classes="tool" HorizontalAlignment="Right" Padding="18,8" Click="Close_Click" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</local:ChromeWindow>
