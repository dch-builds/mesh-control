<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MeshControl.Mac"
        x:Class="MeshControl.Mac.QuickSearchWindow"
        Title="Recherche rapide" Width="620" SizeToContent="Height" CanResize="False"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">

  <!-- Portage de UI/QuickSearchWindow.xaml (version Windows) : palette
       flottante, coins arrondis, ombre portée. -->
  <Window.Styles>
    <Style Selector="ListBox.palette > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="Transparent" CornerRadius="9" Padding="12,9">
            <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.palette > ListBoxItem:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="ListBox.palette > ListBoxItem:selected /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Margin="18"
          BoxShadow="0 4 28 0 #55000000">
    <StackPanel>
      <!-- Machine choisie : visible seulement à l'étape des actions -->
      <Border x:Name="ContextPanel" IsVisible="False" Background="{DynamicResource AccentSoftBrush}"
              CornerRadius="14,14,0,0" Padding="18,9">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="🖥" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
          <TextBlock x:Name="ContextLabel" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="· choisir une action" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <!-- Champ de saisie -->
      <Grid Margin="18,16,18,10" ColumnDefinitions="Auto,*">
        <local:Icon Kind="Search" Size="17" Foreground="{DynamicResource PlaceholderBrush}"
                    VerticalAlignment="Center" Margin="0,0,12,0" />
        <Panel Grid.Column="1">
          <TextBox x:Name="QueryBox" Classes="bare" FontSize="18" Padding="0,4"
                   TextChanged="QueryBox_TextChanged" />
          <TextBlock x:Name="Placeholder" Text="Nom d'une machine…" FontSize="18"
                     Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Panel>
      </Grid>

      <Border Height="1" Background="{DynamicResource SeparatorBrush}" />

      <!-- Résultats : machines (étape 1), actions (étape 2) -->
      <ListBox x:Name="ResultList" Classes="palette" MaxHeight="330" BorderThickness="0" Background="Transparent"
               Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               DoubleTapped="ResultList_DoubleTapped">
        <ListBox.DataTemplates>
          <DataTemplate DataType="local:ActionRow">
            <Grid ColumnDefinitions="Auto,*" Opacity="{Binding RowOpacity}">
              <Panel Width="30" Height="30" Margin="0,0,12,0">
                <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="8" />
                <TextBlock Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Panel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="local:DeviceRow">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Panel Width="30" Height="30" Margin="0,0,12,0">
                <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="8" />
                <TextBlock Text="{Binding OsGlyph}" FontSize="15" Foreground="{Binding OsGlyphColor}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Stroke="{DynamicResource CardBrush}"
                         StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" />
              </Panel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding PaletteCaption}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{Binding BadgeForeground}" VerticalAlignment="Center" Margin="10,0,4,0" />
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>

      <!-- Aide en pied -->
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,14,14" Padding="16,8">
        <TextBlock x:Name="HintText" Classes="caption" Text="↑↓ naviguer · Entrée se connecter · Échap fermer" />
      </Border>
    </StackPanel>
  </Border>
</Window>
