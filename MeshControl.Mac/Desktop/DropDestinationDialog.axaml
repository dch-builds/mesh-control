<local:ChromeWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:MeshControl.Mac"
                   x:Class="MeshControl.Mac.DropDestinationDialog"
                   Width="520" Height="580" MinWidth="420" MinHeight="420"
                   WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- Portage de Desktop/DropDestinationDialog.xaml (version Windows). -->
  <local:ChromeWindow.Resources>
    <!-- Une ligne d'emplacement ou de dossier : pastille, nom, chemin. -->
    <DataTemplate x:Key="ShortcutTemplate" DataType="local:DropShortcut">
      <Grid ColumnDefinitions="Auto,*" Margin="10,2" ToolTip.Tip="{Binding Path}">
        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
          <local:Icon Kind="{Binding Glyph}" Size="14" Foreground="{DynamicResource AccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis" />
          <!-- Les dossiers parcourus n'ont pas de détail : pas de ligne vide. -->
          <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0" IsVisible="{Binding HasDetail}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </local:ChromeWindow.Resources>

  <DockPanel>
    <local:TitleBar DockPanel.Dock="Top" Title="Envoyer vers la machine" ShowMinMax="False" />

    <DockPanel Margin="20,16,20,18">
      <!-- En-tête -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <TextBlock Text="Où envoyer ces fichiers ?" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="SummaryText" Classes="caption" FontSize="12" Margin="0,3,0,0"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- Pied : chemin choisi et boutons -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock Text="Dossier de destination" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="PathBox" FontSize="13" TextChanged="PathBox_TextChanged" KeyDown="PathBox_KeyDown" />
        <TextBlock x:Name="ErrorText" Classes="caption" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False" />
        <TextBlock Classes="caption" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Le dossier est créé s'il n'existe pas. Un fichier du même nom est remplacé." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="Annuler" Classes="tool" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0" />
          <Button x:Name="SendButton" Content="Envoyer" Classes="primary" Click="Send_Click" Padding="18,8"
                  HorizontalAlignment="Right" />
        </StackPanel>
      </StackPanel>

      <!-- Emplacements courants de la machine, ou navigation libre -->
      <Border Classes="card">
        <DockPanel>
          <!-- En-tête des emplacements -->
          <Grid x:Name="ShortcutsHeader" DockPanel.Dock="Top" Margin="16,10,10,6">
            <TextBlock Text="Emplacements" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="LoadingText" Classes="caption" VerticalAlignment="Center" Margin="0,0,10,0"
                         Text="Recherche des dossiers de la machine…" />
              <Button Content="Parcourir…" Classes="tool" Click="Browse_Click" Padding="10,4"
                      ToolTip.Tip="Choisir un dossier en naviguant sur la machine" />
            </StackPanel>
          </Grid>

          <!-- En-tête de la navigation : retour, parent, chemin affiché -->
          <Grid x:Name="BrowseHeader" DockPanel.Dock="Top" Margin="10,8,14,6" IsVisible="False"
                ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Classes="icon" Click="BackToShortcuts_Click" ToolTip.Tip="Revenir aux emplacements">
              <local:Icon Kind="ArrowLeft" Size="11" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="1" Classes="icon" Margin="2,0,0,0" Click="Up_Click"
                    ToolTip.Tip="Dossier parent">
              <local:Icon Kind="ArrowUp" Size="11" />
            </Button>
            <TextBlock x:Name="BrowsePathText" Grid.Column="2" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,8,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BrowseStatus" Grid.Column="3" Classes="caption" VerticalAlignment="Center" />
          </Grid>

          <Panel>
            <ListBox x:Name="ShortcutList" Classes="files" Margin="0,0,0,6"
                     ItemTemplate="{StaticResource ShortcutTemplate}"
                     SelectionChanged="ShortcutList_SelectionChanged" DoubleTapped="ShortcutList_DoubleTapped" />

            <!-- Un clic choisit le sous-dossier, un double-clic y entre. -->
            <ListBox x:Name="FolderList" Classes="files" Margin="0,0,0,6" IsVisible="False"
                     ItemTemplate="{StaticResource ShortcutTemplate}"
                     SelectionChanged="FolderList_SelectionChanged" DoubleTapped="FolderList_DoubleTapped" />
          </Panel>
        </DockPanel>
      </Border>
    </DockPanel>
  </DockPanel>
</local:ChromeWindow>
